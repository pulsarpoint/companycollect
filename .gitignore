.DS_Store
.idea/
.vscode/
**/.superpowers/

# Browser-automation scratch output: page snapshots, console logs and
# screenshots written by the Playwright MCP server wherever it is run from.
# Session debris, not source -- 74 of these were committed by accident.
.playwright-mcp/

# Local environment files. Keep examples tracked.
.env
*.env
*.env.local
!*.env.example
!**/.env.example

# Local Bolagsverket OAuth credentials must never be committed.
corpscout/services/dagster_v3/docs/sweden-api/client_credentials*.txt

# Local runtime data and generated artifacts.
data/
**/data/
companies/data/
companies/data/*/countrydata/
**/nats-data/

# Bundled, versioned source data required by the Finland XBRL parser.
!corpscout/services/dagster_v3/src/dagster_v3/defs/finland_xbrl/data/
!corpscout/services/dagster_v3/src/dagster_v3/defs/finland_xbrl/data/finland_sbr_taxonomy_catalog.csv
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.dg/
**/.dagster_home/
**/.tmp_dagster_home*/
**/dist/
**/build/
corpscout/ui/.react-router/
.worktrees/
claude-code-plugins-plus-skills/

# Go build outputs.
**/bin/
companies/*/bin/
*.test
coverage.out

# Editor swap/backup files.
*.swp
*.swo
*~

# uv lockfiles in the commoncrawl helper projects (dagster_v3 tracks its own).
corpscout/commoncrawl/**/uv.lock
!corpscout/commoncrawl/cc-processor/cc-warc-index-builder/uv.lock


corpscout/dagster_v3/storage/
companies/analysis/sweden/data_model/
