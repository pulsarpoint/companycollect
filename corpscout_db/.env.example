# Central Postgres container.
POSTGRES_DATA_DIR=/opt/corpscoutdb/data
POSTGRES_BIND_ADDR=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me

# Bootstrap/admin connection.
# Existing companycollect uses corpscout as the bootstrap superuser.
POSTGRES_HOST=companycollect
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=corpscout
POSTGRES_ADMIN_PASSWORD=change-me

# Corpscout application database and roles.
CORPSCOUT_DB=corpscout
CORPSCOUT_TEST_DB=corpscout_test
CORPSCOUT_USER=corpscout
CORPSCOUT_PASSWORD=change-me
CORPSCOUT_ANON_ROLE=corpscout_anon

# Temporal persistence databases and role.
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility
TEMPORAL_USER=temporal
TEMPORAL_PASSWORD=change-me
