{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thailand Company Profile",
  "description": "Country-specific company profile for Thailand. The core source is the DBD OpenAPI (openapi.dbd.go.th) — a fully OPEN official API (no key) keyed on the 13-digit juristic person ID, which is BOTH the company registration number AND the Tax ID (one number; VAT uses the same number, no separate VAT id). It returns name TH/EN, legal form, register date, status, TSIC activity, registered & paid-up capital (THB), and a structured address. Full annual financial statements come from the DBD DataWarehouse (login-gated) and SET (listed, public). Currency THB; names in Thai + English. Directors/shareholders are personal data (PDPA) and are not exposed by the open API.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Thailand" },
    "country_slug": { "type": "string", "const": "thailand" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["juristic_id"],
      "properties": {
        "juristic_id": { "type": "string", "description": "13-digit juristic person ID = company registration number = Tax ID. Primary join key.", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicID", "x-join-key": true, "x-freshness": "live" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "tax_id": { "type": ["string", "null"], "description": "= juristic_id (same 13-digit number).", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicID" },
        "vat_id": { "type": ["string", "null"], "description": "Same 13-digit Tax ID — no separate VAT number.", "x-access": "same_as_tax_id" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "name_en": { "type": ["string", "null"], "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicNameEN" },
        "name_th": { "type": ["string", "null"], "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicNameTH" },
        "legal_form": { "type": ["string", "null"], "description": "บริษัทจำกัด / บริษัทมหาชนจำกัด / ห้างหุ้นส่วน.", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicType" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "ยังดำเนินกิจการอยู่ = active, etc.", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicStatus" },
        "register_date": { "type": ["string", "null"], "description": "YYYYMMDD.", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicRegisterDate" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "tsic_code": { "type": ["string", "null"], "description": "TSIC activity code.", "x-source": "dbd_openapi_juristic", "x-source-path": "td:JuristicObjectiveCode" },
        "tsic_text_en": { "type": ["string", "null"], "x-source": "dbd_openapi_juristic", "x-source-path": "td:JuristicObjectiveTextEN" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "description": "Assembled from the structured address.", "x-source": "dbd_openapi_juristic", "x-source-path": "cd:OrganizationJuristicAddress" },
        "province": { "type": ["string", "null"], "description": "cr:CountrySubDivision (e.g. TH-10 = Bangkok).", "x-source": "dbd_openapi_juristic", "x-source-path": "cr:CountrySubDivisionTextTH" }
      }
    },
    "capital": {
      "type": "object",
      "description": "Registered & paid-up capital (THB) — open via the DBD OpenAPI.",
      "x-source": "dbd_openapi_juristic",
      "properties": {
        "registered_capital": { "type": ["number", "null"], "x-source-path": "cd:OrganizationJuristicRegisterCapital" },
        "paid_up_capital": { "type": ["number", "null"], "x-source-path": "cd:OrganizationJuristicPaidUpCapital" },
        "currency": { "type": "string", "const": "THB" }
      }
    },
    "listing": {
      "type": "object",
      "description": "Present only for SET-listed companies.",
      "x-source": "set_listed",
      "properties": {
        "set_symbol": { "type": ["string", "null"], "x-source-path": "symbol" },
        "sector": { "type": ["string", "null"], "x-source-path": "sector" }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "PLANNING-ONLY / gated. Annual balance sheet + income statement (THB) from DBD DataWarehouse (login) or SET (listed).",
      "x-source": "dbd_datawarehouse",
      "x-access": "login_gated",
      "items": {
        "type": "object",
        "properties": {
          "financial_year": { "type": ["string", "null"] },
          "total_assets": { "type": ["number", "null"] },
          "total_revenue": { "type": ["number", "null"] },
          "net_profit": { "type": ["number", "null"] },
          "currency": { "type": "string", "const": "THB" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
