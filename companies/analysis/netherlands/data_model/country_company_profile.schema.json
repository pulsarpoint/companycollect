{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Netherlands Company Profile",
  "description": "Country-specific company profile for the Netherlands. The KvK publishes two open (CC-BY 4.0) datasets — basic company data and structured annual accounts (jaarrekeningen) — but both are ANONYMISED in bulk (no KvK number). Identified data keys on the KvK-nummer (8 digits): the free HVDS open-data API returns basic + financial data by KvK number; names/addresses/officers require the paid KvK Handelsregister API. RSIN (9) = VAT base; UBO is restricted.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Netherlands" },
    "country_slug": { "type": "string", "const": "netherlands" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["kvk_nummer"],
      "properties": {
        "kvk_nummer": {
          "type": ["string", "null"],
          "description": "8-digit KvK number; company id and join key. NOT in the open bulk (anonymised) — via the HVDS API (by number) or the paid KvK API.",
          "x-source": "kvk_handelsregister_api",
          "x-source-path": "kvkNummer",
          "x-join-key": true,
          "x-access": "paid_or_hvds_api"
        },
        "rsin": { "type": ["string", "null"], "description": "9-digit RSIN (tax/legal-entity number; VAT base).", "x-source": "kvk_handelsregister_api", "x-source-path": "rsin" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "vat_id": { "type": ["string", "null"], "description": "NL + RSIN + B + 2 (legal entities).", "x-source": "vies_vat", "x-source-path": "vatNumber" },
        "vat_valid": { "type": ["boolean", "null"], "x-source": "vies_vat", "x-source-path": "valid" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "description": "PAID KvK API (stripped from open data).", "x-source": "kvk_handelsregister_api", "x-source-path": "naam", "x-access": "paid" },
        "legal_form": { "type": ["string", "null"], "description": "BV/NV/EZ/VOF/Stichting (open: Rechtsvorm).", "x-source": "kvk_open_basis", "x-source-path": "Rechtsvorm" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "active": { "type": ["boolean", "null"], "x-source": "kvk_open_basis", "x-source-path": "Actief" },
        "insolvency": { "type": ["string", "null"], "x-source": "kvk_open_basis", "x-source-path": "Insolventie" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "sbi_main": { "type": ["string", "null"], "description": "Main SBI activity.", "x-source": "kvk_open_basis", "x-source-path": "Hoofdactiviteiten" },
        "sbi_all": { "type": "array", "items": { "type": "string" }, "x-source": "kvk_open_basis", "x-source-path": "SBI activiteiten" }
      }
    },
    "incorporation": {
      "type": "object",
      "properties": {
        "registration_date": { "type": ["string", "null"], "format": "date", "description": "Datum aanvang (YYYYMMDD).", "x-source": "kvk_open_basis", "x-source-path": "Datum aanvang" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "postcode_region": { "type": ["string", "null"], "description": "2-digit region (open data).", "x-source": "kvk_open_basis", "x-source-path": "Postcode regio" },
        "registered_address": { "type": ["string", "null"], "description": "Full address (PAID KvK API).", "x-source": "kvk_handelsregister_api", "x-source-path": "adressen", "x-access": "paid" }
      }
    },
    "officers": {
      "type": "array",
      "description": "PLANNING-ONLY / PAID. Officers (functionarissen) via the KvK Basisprofiel. PERSONAL DATA (GDPR).",
      "x-access": "paid",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "kvk_handelsregister_api", "x-source-path": "functionarissen", "x-personal-data": true },
          "role": { "type": ["string", "null"] }
        }
      }
    },
    "beneficial_owners": {
      "type": "array",
      "description": "PLANNING-ONLY. UBO-register — restricted (AML-obliged entities, post-CJEU). PERSONAL DATA (GDPR).",
      "x-access": "restricted",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "ubo_register", "x-source-path": "ubo[].naam", "x-personal-data": true },
          "nature_and_extent_of_interest": { "type": ["string", "null"], "x-source": "ubo_register", "x-source-path": "ubo[].aardEnOmvang" }
        }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "STRUCTURED annual accounts (jaarrekeningen, CC-BY 4.0). Open bulk is ANONYMISED (no identifier); identified per-company via the HVDS API by KvK number or a vendor. Balance-sheet figures; EUR. Most BV file abridged (balance sheet only).",
      "x-source": "kvk_open_jaarrekeningen",
      "items": {
        "type": "object",
        "required": ["fiscal_year"],
        "properties": {
          "fiscal_year": { "type": "integer", "x-source-path": "FinancialYear" },
          "adoption_date": { "type": ["string", "null"], "format": "date", "x-source-path": "DocumentAdoptionDate" },
          "sbi_business_code": { "type": ["string", "null"], "x-source-path": "SbiBusinessCode" },
          "total_assets": { "type": ["number", "null"], "x-source-path": "Assets" },
          "equity": { "type": ["number", "null"], "x-source-path": "Equity" },
          "liabilities": { "type": ["number", "null"], "x-source-path": "Liabilities" },
          "provisions": { "type": ["number", "null"], "x-source-path": "Provisions" },
          "called_up_share_capital": { "type": ["number", "null"], "x-source-path": "CalledUpShareCapital" },
          "currency": { "type": "string", "const": "EUR" },
          "before_after_appropriation": { "type": ["string", "null"], "x-source-path": "BalanceSheetBeforeAfterAppropriationResults" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}
