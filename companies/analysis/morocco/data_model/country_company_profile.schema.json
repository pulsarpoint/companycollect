{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morocco Company Profile",
  "description": "Country-specific company profile for Morocco. The official register is OMPIC (Registre Central du Commerce), keyed on the ICE (Identifiant Commun de l'Entreprise, 15-digit unified company id), with the RC number (Registre du Commerce, per court) and the IF (Identifiant Fiscal, tax id). OMPIC company data is served via directinfo.ma — the free basic search is reCAPTCHA-gated and detailed data + Bilans (financial statements) + the OMPIC API are paid/subscription; there is no open bulk. Listed-company data + financials are OPEN via the Casablanca Stock Exchange, keyed on the ticker / ISIN. Currency MAD; French + Arabic. Managers/shareholders (dirigeants/associés) are personal data (Law 09-08) — redact. No OMPIC per-company values were captured; listed identity is from the Bourse.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Morocco" },
    "country_slug": { "type": "string", "const": "morocco" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["ice"],
      "properties": {
        "ice": { "type": ["string", "null"], "description": "Identifiant Commun de l'Entreprise — 15-digit unified company id. Primary join key. Gated (OMPIC reCAPTCHA/paid).", "x-source": "ompic_directinfo", "x-source-path": "ice", "x-join-key": true, "x-freshness": "live", "x-access": "recaptcha_paid" },
        "rc_number": { "type": ["string", "null"], "description": "Registre du Commerce number (per court).", "x-source": "ompic_directinfo", "x-source-path": "rc_number" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "if_tax_id": { "type": ["string", "null"], "description": "Identifiant Fiscal (IF) — tax id (DGI).", "x-source": "ompic_directinfo", "x-source-path": "if_tax_id" },
        "vat_id": { "type": ["string", "null"], "description": "Not separate — TVA is tied to the IF.", "x-access": "not_available" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "ompic_directinfo", "x-source-path": "raison_sociale", "x-source-alt": "casablanca_bourse.company_name" },
        "legal_form": { "type": ["string", "null"], "description": "SA / SARL / SARL-AU / SNC / SCS / succursale.", "x-source": "ompic_directinfo", "x-source-path": "forme_juridique" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "en activité / en liquidation / radiée.", "x-source": "ompic_directinfo", "x-source-path": "statut" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "activity_object": { "type": ["string", "null"], "x-source": "ompic_directinfo", "x-source-path": "activite" },
        "bourse_sector": { "type": ["string", "null"], "description": "Casablanca Bourse sector (listed).", "x-source": "casablanca_bourse", "x-source-path": "sector" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "ompic_directinfo", "x-source-path": "adresse" }
      }
    },
    "capital": {
      "type": "object",
      "description": "Share capital (MAD), from gated OMPIC data.",
      "x-source": "ompic_directinfo",
      "x-access": "paid",
      "properties": {
        "capital_social": { "type": ["number", "null"], "x-source-path": "capital_social" },
        "currency": { "type": "string", "const": "MAD" }
      }
    },
    "officers": {
      "type": "array",
      "description": "Managers (dirigeants) / shareholders (associés) from gated OMPIC data. PERSONAL DATA (Law 09-08) — REDACT.",
      "x-source": "ompic_directinfo",
      "x-source-path": "dirigeants",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "listing": {
      "type": "object",
      "description": "Present only for Casablanca-listed companies (open).",
      "x-source": "casablanca_bourse",
      "properties": {
        "ticker": { "type": ["string", "null"], "x-source-path": "ticker" },
        "isin": { "type": ["string", "null"], "x-source-path": "isin" },
        "sector": { "type": ["string", "null"], "x-source-path": "sector" }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "Financial statements (MAD). OPEN via Casablanca Bourse for listed companies; OMPIC Bilans (paid) for the rest.",
      "x-source": "casablanca_bourse",
      "x-access": "open_for_listed_paid_otherwise",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": ["string", "null"] },
          "currency": { "type": "string", "const": "MAD" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
