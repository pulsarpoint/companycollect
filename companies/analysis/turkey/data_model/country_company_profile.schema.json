{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turkey Company Profile",
  "description": "Country-specific company profile for Turkey. Keyed on the MERSIS number (16-digit Central Registry System number, company id) and the VKN (10-digit tax id). Turkey has VAT (KDV) but NO separate VAT number — the VKN is the tax id. Identity is via MERSIS (free per-company query, no open bulk) + the Trade Registry Gazette (events). Financial statements are public only for LISTED companies via KAP (Public Disclosure Platform, TRY) — verified (808 listed companies). Private-company financials are not public. Directors/shareholders are personal data (KVKK).",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Turkey" },
    "country_slug": { "type": "string", "const": "turkey" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["mersis_no"],
      "properties": {
        "mersis_no": { "type": ["string", "null"], "description": "MERSIS number (16-digit). Company id.", "x-source": "mersis_registry", "x-source-path": "mersis.mersis_no", "x-join-key": true },
        "trade_registry_no": { "type": ["string", "null"], "description": "Ticaret Sicil No.", "x-source": "mersis_registry", "x-source-path": "mersis.ticaret_sicil_no" },
        "kap_id": { "type": ["string", "null"], "description": "KAP id (listed companies).", "x-source": "kap_disclosure", "x-source-path": "company.kap_id" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "tax_id": { "type": ["string", "null"], "description": "VKN (10-digit).", "x-source": "mersis_registry", "x-source-path": "mersis.vkn" },
        "vat_id": { "type": ["string", "null"], "description": "No separate VAT number — VKN serves as the VAT (KDV) id.", "x-access": "not_available" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "mersis_registry", "x-source-path": "mersis.unvan" },
        "company_type": { "type": ["string", "null"], "description": "A.Ş. / Ltd. Şti. / ...", "x-source": "mersis_registry", "x-source-path": "mersis.sirket_turu" }
      }
    },
    "status": {
      "type": "object",
      "properties": { "status": { "type": ["string", "null"], "x-source": "mersis_registry", "x-source-path": "mersis.durum" } }
    },
    "activity": {
      "type": "object",
      "properties": { "nace_code": { "type": ["string", "null"], "x-source": "mersis_registry", "x-source-path": "mersis.nace" } }
    },
    "registered_location": {
      "type": "object",
      "properties": { "registered_address": { "type": ["string", "null"], "x-source": "mersis_registry", "x-source-path": "mersis.adres" } }
    },
    "documents": {
      "type": "array",
      "description": "Trade Registry Gazette announcements (incorporation/amendment/dissolution).",
      "x-source": "ticaret_sicil_gazetesi",
      "items": { "type": "object", "properties": { "type": { "type": ["string", "null"] }, "date": { "type": ["string", "null"], "format": "date" } } }
    },
    "officers": {
      "type": "array",
      "description": "PLANNING-ONLY. Directors/shareholders from the gazette / trade-registry records. PERSONAL DATA (KVKK) — redact.",
      "x-source": "ticaret_sicil_gazetesi",
      "x-access": "gazette_personal_data",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "financial_statements": {
      "type": "array",
      "description": "LISTED companies only (KAP, Public Disclosure Platform), Turkish IFRS, TRY. Private-company financials are not public.",
      "x-source": "kap_disclosure",
      "x-access": "listed_only",
      "items": {
        "type": "object",
        "properties": {
          "period": { "type": ["string", "null"] },
          "revenue": { "type": ["number", "null"] },
          "net_profit": { "type": ["number", "null"] },
          "total_assets": { "type": ["number", "null"] },
          "currency": { "type": "string", "const": "TRY" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
