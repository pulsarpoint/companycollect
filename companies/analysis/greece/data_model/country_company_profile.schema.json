{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Greece Company Profile",
  "description": "Country-specific company profile for Greece. The authoritative register is GEMI, keyed on the GEMI number; the ΑΦΜ (AFM, 9-digit tax id) is the universal cross-source join key (VAT = EL + ΑΦΜ). GEMI is free to search manually but its API is reCAPTCHA-protected + rate-limited (no open bulk), and financial statements are document-based PDF — so several sections are planning-only / blocked-for-automation.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Greece" },
    "country_slug": { "type": "string", "const": "greece" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["gemi_number"],
      "properties": {
        "gemi_number": {
          "type": "string",
          "description": "GEMI registry number — register-side company id.",
          "x-source": "gemi_portal",
          "x-source-path": "gemi_number",
          "x-join-key": true,
          "x-access": "public_manual"
        }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "afm": {
          "type": ["string", "null"],
          "description": "ΑΦΜ — 9-digit tax id; the universal cross-source join key.",
          "x-source": "gemi_portal",
          "x-source-path": "afm",
          "x-join-key": true
        },
        "vat_id": {
          "type": ["string", "null"],
          "description": "EL + ΑΦΜ.",
          "x-source": "vies_vat",
          "x-source-path": "vatNumber"
        },
        "vat_valid": {
          "type": ["boolean", "null"],
          "x-source": "vies_vat",
          "x-source-path": "valid"
        }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": "string", "description": "Greek name (+ Latin transliteration).", "x-source": "gemi_portal", "x-source-path": "name" },
        "legal_form": { "type": ["string", "null"], "description": "ΑΕ/ΕΠΕ/ΙΚΕ/ΟΕ/ΕΕ/…", "x-source": "gemi_portal", "x-source-path": "legal_form" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "description": "ΕΝΕΡΓΗ / ΛΥΘΕΙΣΑ / ΥΠΟ ΕΚΚΑΘΑΡΙΣΗ", "x-source": "gemi_portal", "x-source-path": "status" },
        "tax_status": { "type": ["string", "null"], "description": "Active/ceased (tax-side).", "x-source": "aade_rgwspublic", "x-source-path": "deactivationFlag", "x-access": "restricted" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "kad": { "type": "array", "items": { "type": "string" }, "description": "ΚΑΔ activity codes.", "x-source": "gemi_portal", "x-source-path": "kad" },
        "kad_primary": { "type": ["string", "null"], "description": "Primary ΚΑΔ (flagged by AADE).", "x-source": "aade_rgwspublic", "x-source-path": "firmActivities[].kad", "x-access": "restricted" }
      }
    },
    "incorporation": {
      "type": "object",
      "properties": {
        "incorporation_date": { "type": ["string", "null"], "format": "date", "x-source": "gemi_portal", "x-source-path": "incorporation_date" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "gemi_portal", "x-source-path": "registered_address" },
        "municipality": { "type": ["string", "null"], "description": "δήμος, parsed from address." },
        "region": { "type": ["string", "null"], "description": "περιφέρεια, parsed from address." }
      }
    },
    "officers": {
      "type": "array",
      "description": "Directors/representatives (νόμιμοι εκπρόσωποι). PERSONAL DATA (GDPR).",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "gemi_portal", "x-source-path": "representatives[]", "x-personal-data": true },
          "role": { "type": ["string", "null"] }
        }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "PLANNING-ONLY. Financial statements filed to GEMI as PDF (ΕΛΠ/IFRS) — structured only after OCR/parse, or via a commercial provider. Currency EUR.",
      "x-access": "public_document_pdf",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": "string", "x-source": "gemi_financial_statements", "x-source-path": "fiscal_year" },
          "accounting_standard": { "type": ["string", "null"], "description": "ΕΛΠ | IFRS", "x-source": "gemi_financial_statements", "x-source-path": "accounting_standard" },
          "balance_sheet": { "type": ["object", "null"], "x-source": "gemi_financial_statements", "x-source-path": "isologismos.balance_sheet" },
          "income_statement": { "type": ["object", "null"], "x-source": "gemi_financial_statements", "x-source-path": "oikonomikes_katastaseis.income_statement" },
          "currency": { "type": "string", "const": "EUR" },
          "source": { "type": "string", "description": "gemi_financial_statements (PDF) | commercial_aggregators (parsed)" }
        }
      }
    },
    "public_sector_links": {
      "type": "array",
      "description": "Open cross-references (Diavgeia acts / procurement awards) referencing the company ΑΦΜ.",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "description": "diavgeia | procurement_kimdis" },
          "afm": { "type": "string", "x-source": "diavgeia", "x-source-path": "afm" },
          "amount": { "type": ["number", "null"] }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}
