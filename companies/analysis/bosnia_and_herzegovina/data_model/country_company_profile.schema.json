{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bosnia and Herzegovina Company Profile",
  "description": "Country-specific company profile for Bosnia and Herzegovina. BiH has no single national register: identity comes from the entity court registers — Republika Srpska (bizreg.esrpska.com, JSON per-company search, RECOMMENDED) and Federation of BiH + Brčko (bizreg.pravosudje.ba, Oracle APEX, per-company). The country-wide join key is the JIB (13-digit unique id = company id = tax id). The PDV broj (12-digit VAT) is assigned separately by UINO. Annual financial statements (bilans stanja / bilans uspjeha, BAM) are filed with APIF (RS) / FIA (FBiH) and accessed per company for a fee (planning-only). Founders/representatives are personal data (BiH Law on Protection of Personal Data) — redact.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Bosnia and Herzegovina" },
    "country_slug": { "type": "string", "const": "bosnia_and_herzegovina" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["jib"],
      "properties": {
        "jib": { "type": "string", "description": "Jedinstveni identifikacioni broj — 13-digit unique id = company id = tax id. Country-wide join key.", "x-source": "rs_business_register", "x-source-path": "Records[].JIB", "x-join-key": true, "x-freshness": "live" },
        "mbs": { "type": ["string", "null"], "description": "Matični broj subjekta — court registration number.", "x-source": "rs_business_register", "x-source-path": "Records[].MBS" },
        "mb": { "type": ["string", "null"], "description": "Matični broj — 7-digit statistical number.", "x-source": "rs_business_register", "x-source-path": "Records[].MB" },
        "entity": { "type": ["string", "null"], "description": "Which BiH register holds the entity: Republika Srpska, Federation of BiH, or Brčko District.", "enum": ["Republika Srpska", "Federation of BiH", "Brčko District", null] }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "tax_id": { "type": ["string", "null"], "description": "= JIB.", "x-source": "rs_business_register", "x-source-path": "Records[].JIB" },
        "pdv_broj": { "type": ["string", "null"], "description": "12-digit VAT number, assigned by UINO for VAT-registered entities (separate from JIB).", "x-source": "uino_pdv", "x-access": "free_per_company" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "business_name": { "type": ["string", "null"], "x-source": "rs_business_register", "x-source-path": "Records[].PoslovnoIme" },
        "short_name": { "type": ["string", "null"], "x-source": "rs_business_register", "x-source-path": "Records[].SkracenoPoslovnoIme" },
        "legal_form": { "type": ["string", "null"], "description": "d.o.o. / a.d. / d.d. / s.p. / javno preduzeće (derived from name/extract)." }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "registrovan / u likvidaciji / u stečaju / brisan (strip HTML).", "x-source": "rs_business_register", "x-source-path": "Records[].StatusPoslovniSubjekatOpis" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "activity_code": { "type": ["string", "null"], "description": "KD BiH (~NACE Rev.2) code.", "x-source": "rs_business_register", "x-source-path": "Records[].PreteznaDjelatnost(code)" },
        "activity_text": { "type": ["string", "null"], "x-source": "rs_business_register", "x-source-path": "Records[].PreteznaDjelatnost(text)" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "rs_business_register", "x-source-path": "Records[].Sjediste" },
        "municipality": { "type": ["string", "null"], "description": "Parsed from Sjediste." },
        "branch_count": { "type": ["integer", "null"], "x-source": "rs_business_register", "x-source-path": "Records[].PoslovneJedinice" }
      }
    },
    "owners": {
      "type": "array",
      "description": "Founders (Osnivači). Legal-entity founders kept; natural persons are PERSONAL DATA (BiH Law on Protection of Personal Data) — REDACT.",
      "x-source": "rs_business_register",
      "x-source-path": "Records[].Osnivaci",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "kind": { "type": ["string", "null"], "enum": ["legal_entity", "natural_person", null] } } }
    },
    "officers": {
      "type": "array",
      "description": "Responsible person / representatives. PERSONAL DATA — REDACT natural persons.",
      "x-source": "rs_business_register",
      "x-source-path": "Records[].OdgovornoLice + Home/ListLicaOvlastenaZaZastupanje",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "financial_statements": {
      "type": "array",
      "description": "PLANNING-ONLY. Annual bilans stanja / bilans uspjeha from APIF RFI (RS) / FIA (FBiH), BAM. Paid per company; no open bulk.",
      "x-source": "apif_rfi_financials",
      "x-access": "paid_per_company",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": ["string", "null"] },
          "total_assets": { "type": ["number", "null"] },
          "equity": { "type": ["number", "null"] },
          "operating_revenue": { "type": ["number", "null"] },
          "net_result": { "type": ["number", "null"] },
          "currency": { "type": "string", "const": "BAM" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
