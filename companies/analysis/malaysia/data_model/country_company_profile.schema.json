{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Malaysia Company Profile",
  "description": "Country-specific company profile for Malaysia. The official register is SSM (Companies Commission), keyed on the company registration number — the new 12-digit format (since 2019) with the old NNNNNNN-A format as a cross-reference. SSM company profiles and financial statements are PAID products sold via SSM e-Info and MyData-SSM (only a free e-Search for existence is open). The TIN (LHDN) is the tax id; Malaysia uses SST (no VAT/GST since 2018, no separate VAT number). Listed-company financials come from Bursa Malaysia (public via browser; WAF-blocked for automation here). Currency MYR; Malay + English. Directors/shareholders are personal data (PDPA 2010) — redact. No per-company values were captured (paywall/WAF not bypassed).",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Malaysia" },
    "country_slug": { "type": "string", "const": "malaysia" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["registration_number_new"],
      "properties": {
        "registration_number_new": { "type": ["string", "null"], "description": "12-digit SSM company registration number (since 2019). Primary id / join key.", "x-source": "ssm_einfo", "x-source-path": "registration_number_new", "x-join-key": true, "x-freshness": "live", "x-access": "paid" },
        "registration_number_old": { "type": ["string", "null"], "description": "Legacy SSM number (NNNNNNN-A).", "x-source": "ssm_einfo", "x-source-path": "registration_number_old" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "tin": { "type": ["string", "null"], "description": "Income tax number (LHDN; companies prefixed C).", "x-source": "lhdn", "x-access": "per_company" },
        "sst_number": { "type": ["string", "null"], "description": "Sales & Service Tax registration (no VAT/GST since 2018).", "x-source": "lhdn" },
        "vat_id": { "type": ["string", "null"], "description": "Not applicable — Malaysia uses SST, no VAT.", "x-access": "not_available" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "ssm_einfo", "x-source-path": "company_name" },
        "company_type": { "type": ["string", "null"], "description": "Sdn. Bhd. / Bhd. / PLT.", "x-source": "ssm_einfo", "x-source-path": "company_type" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "Existing / Dissolved / Wound up / Struck off.", "x-source": "ssm_einfo", "x-source-path": "status" },
        "incorporation_date": { "type": ["string", "null"], "format": "date", "x-source": "ssm_einfo", "x-source-path": "incorporation_date" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "msic_code": { "type": ["string", "null"], "description": "MSIC business activity.", "x-source": "ssm_einfo", "x-source-path": "nature_of_business" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "ssm_einfo", "x-source-path": "registered_address" },
        "state": { "type": ["string", "null"] }
      }
    },
    "capital": {
      "type": "object",
      "description": "Paid-up capital (MYR), from the paid SSM Company Profile.",
      "x-source": "ssm_einfo",
      "x-access": "paid",
      "properties": {
        "paid_up_capital": { "type": ["number", "null"], "x-source-path": "paid_up_capital" },
        "currency": { "type": "string", "const": "MYR" }
      }
    },
    "owners": {
      "type": "array",
      "description": "Shareholders from the paid SSM Company Profile. PERSONAL DATA when natural persons (PDPA 2010) — REDACT.",
      "x-source": "ssm_einfo",
      "x-source-path": "shareholders",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "shares": { "type": ["number", "null"] } } }
    },
    "officers": {
      "type": "array",
      "description": "Directors from the paid SSM Company Profile. PERSONAL DATA (incl. NRIC) — REDACT.",
      "x-source": "ssm_einfo",
      "x-source-path": "directors",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "listing": {
      "type": "object",
      "description": "Present only for Bursa-listed companies.",
      "x-source": "bursa_listed",
      "properties": {
        "stock_code": { "type": ["string", "null"], "x-source-path": "stock_code" },
        "sector": { "type": ["string", "null"], "x-source-path": "sector" }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "PAID / gated. Annual financials (revenue, profit, assets, equity, MYR) from SSM Financial Comparison/Historical (paid) or Bursa (listed).",
      "x-source": "ssm_einfo",
      "x-access": "paid",
      "items": {
        "type": "object",
        "properties": {
          "financial_year": { "type": ["string", "null"] },
          "revenue": { "type": ["number", "null"] },
          "net_profit": { "type": ["number", "null"] },
          "currency": { "type": "string", "const": "MYR" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
