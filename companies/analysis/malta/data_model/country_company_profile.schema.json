{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Malta Company Profile",
  "description": "Country-specific company profile for Malta. The authoritative register is the MBR (Malta Business Registry), keyed on the registration number (prefix = entity class, e.g. C = companies). Free basic search gives identity + status; officers, shareholders and financial information are in the register but delivered via paid documents or the paid MBR API; the registry portals are WAF-blocked for automation. VAT (MT+8) is separate; beneficial ownership (UBO) is restricted to legitimate interest.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Malta" },
    "country_slug": { "type": "string", "const": "malta" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["registration_number"],
      "properties": {
        "registration_number": {
          "type": "string",
          "description": "MBR registration number (prefix = entity class: C = companies).",
          "x-source": "mbr_register",
          "x-source-path": "registration_number",
          "x-join-key": true,
          "x-access": "public_manual"
        }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "vat_id": { "type": ["string", "null"], "description": "MT + 8 digits (separate; not in register).", "x-source": "vies_vat", "x-source-path": "vatNumber", "x-access": "external" },
        "vat_valid": { "type": ["boolean", "null"], "x-source": "vies_vat", "x-source-path": "valid" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": "string", "x-source": "mbr_register", "x-source-path": "name" },
        "company_type": { "type": ["string", "null"], "description": "Ltd/plc/partnership.", "x-source": "mbr_register", "x-source-path": "company_type" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "description": "Active / Struck off / Liquidated / Dissolved.", "x-source": "mbr_register", "x-source-path": "status" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "activity_code": { "type": "null", "description": "not_available_in_open_sources (no public NACE in the free register data).", "x-source": null }
      }
    },
    "incorporation": {
      "type": "object",
      "properties": {
        "incorporation_date": { "type": ["string", "null"], "format": "date", "x-source": "mbr_register", "x-source-path": "registration_date" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "mbr_register", "x-source-path": "registered_address" },
        "locality": { "type": ["string", "null"], "description": "parsed from address." }
      }
    },
    "officers": {
      "type": "array",
      "description": "PLANNING-ONLY / PAID. Directors + company secretary (paid documents / API). PERSONAL DATA (GDPR).",
      "x-access": "paid",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "mbr_register", "x-source-path": "officers[]", "x-personal-data": true },
          "role": { "type": ["string", "null"] }
        }
      }
    },
    "shareholders": {
      "type": "array",
      "description": "PLANNING-ONLY / PAID. Registered shareholders (name, share type, degree of control). PERSONAL DATA (GDPR). Distinct from beneficial_owners.",
      "x-access": "paid",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "mbr_register", "x-source-path": "shareholders[]", "x-personal-data": true },
          "share_type": { "type": ["string", "null"] },
          "degree_of_control": { "type": ["string", "null"] }
        }
      }
    },
    "beneficial_owners": {
      "type": "array",
      "description": "PLANNING-ONLY. UBO register — restricted (legitimate interest, post-CJEU). PERSONAL DATA (GDPR).",
      "x-access": "restricted",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "x-source": "rbe_register", "x-source-path": "beneficial_owners[].name", "x-personal-data": true },
          "nature_and_extent_of_interest": { "type": ["string", "null"], "x-source": "rbe_register", "x-source-path": "beneficial_owners[].nature_extent" }
        }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "PLANNING-ONLY / PAID. Annual accounts + annual return (IFRS/GAPSME). Obtained as paid documents (EUR 5-25) or via the paid MBR API/vendor — structured only after OCR/parse. Currency EUR.",
      "x-access": "paid",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": "string", "x-source": "mbr_annual_accounts", "x-source-path": "fiscal_year" },
          "balance_sheet": { "type": ["object", "null"], "x-source": "mbr_annual_accounts", "x-source-path": "balance_sheet" },
          "income_statement": { "type": ["object", "null"], "x-source": "mbr_annual_accounts", "x-source-path": "profit_and_loss" },
          "currency": { "type": "string", "const": "EUR" },
          "source": { "type": "string", "description": "mbr_annual_accounts (paid PDF) | mbr_api (paid) | commercial_aggregators (parsed)" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}
