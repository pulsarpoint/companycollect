{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ukraine Company Profile",
  "description": "Country-specific company profile for Ukraine. The EDR (Unified State Register, Ministry of Justice) is published as open bulk on data.gov.ua under CC-BY 4.0, weekly — one of the world's most open registers: EDRPOU, name, legal form (OPF), status, founders, BENEFICIAL OWNERS (UBO), officers, authorized capital, registration/termination, tax registrations — all open, keyed on the 8-digit EDRPOU. Financials come from the XBRL Financial Reporting System (IFRS reporters) and NSSMC/SMIDA (issuers), joined on EDRPOU. WARTIME CAVEAT: the open export has NO registered address and NO KVED activity code (removed for security since 2022). Founder/officer/beneficial-owner names are PERSONAL DATA — redact. Ukraine has no separate VAT number.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Ukraine" },
    "country_slug": { "type": "string", "const": "ukraine" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["edrpou"],
      "properties": {
        "edrpou": {
          "type": "string",
          "description": "8-digit EDRPOU code. Company id and universal join key (EDR ↔ financials).",
          "x-source": "edr_uo",
          "x-source-path": "SUBJECT/EDRPOU",
          "x-join-key": true,
          "x-access": "public"
        }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "edr_uo", "x-source-path": "SUBJECT/NAME" },
        "short_name": { "type": ["string", "null"], "x-source": "edr_uo", "x-source-path": "SUBJECT/SHORT_NAME" },
        "legal_form": { "type": ["string", "null"], "description": "OPF (ТОВ=LLC, ПП, …).", "x-source": "edr_uo", "x-source-path": "SUBJECT/OPF" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_raw": { "type": ["string", "null"], "x-source": "edr_uo", "x-source-path": "SUBJECT/STAN" },
        "status": { "type": ["string", "null"], "description": "Mapped: active/in_termination/terminated.", "enum": ["active", "in_termination", "terminated", null] }
      }
    },
    "incorporation": {
      "type": "object",
      "properties": {
        "registration_date": { "type": ["string", "null"], "format": "date", "description": "First date in REGISTRATION.", "x-source": "edr_uo", "x-source-path": "SUBJECT/REGISTRATION" },
        "termination_date": { "type": ["string", "null"], "format": "date", "description": "First date in TERMINATED_INFO.", "x-source": "edr_uo", "x-source-path": "SUBJECT/TERMINATED_INFO" }
      }
    },
    "share_capital": {
      "type": "object",
      "properties": {
        "authorized_capital": { "type": ["number", "null"], "description": "Authorized capital (UAH).", "x-source": "edr_uo", "x-source-path": "SUBJECT/AUTHORIZED_CAPITAL" },
        "currency": { "type": "string", "const": "UAH" }
      }
    },
    "tax_registrations": {
      "type": "array",
      "description": "Tax-register memberships (no separate VAT number in UA).",
      "x-source": "edr_uo",
      "x-source-path": "SUBJECT/EXCHANGE_DATA/EXCHANGE_ANSWER/TAX_PAYER_TYPE",
      "items": { "type": "string" }
    },
    "officers": {
      "type": "array",
      "description": "Officers/signatories (SIGNERS). OPEN but PERSONAL DATA — redact name.",
      "x-source": "edr_uo",
      "x-access": "public_personal_data",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-source-path": "SUBJECT/SIGNERS/SIGNER", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "owners": {
      "type": "object",
      "description": "Founders + beneficial owners. OPEN but PERSONAL DATA — redact names.",
      "x-access": "public_personal_data",
      "properties": {
        "founders": { "type": "array", "x-source": "edr_uo", "items": { "type": "object", "properties": { "name": { "type": "string", "x-source-path": "SUBJECT/FOUNDERS/FOUNDER", "x-personal-data": true }, "share": { "type": ["string", "null"] } } } },
        "beneficial_owners": { "type": "array", "x-source": "edr_uo", "items": { "type": "object", "properties": { "name": { "type": "string", "x-source-path": "SUBJECT/BENEFICIARIES/BENEFICIARY", "x-personal-data": true } } } }
      }
    },
    "related_entities": {
      "type": "object",
      "description": "Reorganization links (EDRPOU + name).",
      "x-source": "edr_uo",
      "properties": {
        "predecessors": { "type": "array", "items": { "type": "object" } },
        "assignees": { "type": "array", "items": { "type": "object" } }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "Financials from the XBRL FRS (IFRS reporters) / NSSMC-SMIDA (issuers). UAH. Coverage = IFRS reporters/issuers, not every SME.",
      "x-source": "xbrl_frs",
      "x-access": "public_partial_coverage",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": "integer", "x-source-path": "period" },
          "total_assets": { "type": ["number", "null"], "x-source-path": "assets_total" },
          "equity": { "type": ["number", "null"], "x-source-path": "equity_total" },
          "revenue": { "type": ["number", "null"], "x-source-path": "revenue" },
          "net_profit": { "type": ["number", "null"], "x-source-path": "net_profit" },
          "currency": { "type": "string", "const": "UAH" }
        }
      }
    },
    "registered_location": {
      "type": "object",
      "description": "PLANNING-ONLY. Address NOT in the open export (wartime); restricted full register.",
      "x-access": "restricted",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "edr_full_restricted", "x-source-path": "registered_address" }
      }
    },
    "activity": {
      "type": "object",
      "description": "PLANNING-ONLY. KVED NOT in the open export (wartime); restricted.",
      "x-access": "restricted",
      "properties": {
        "kved_codes": { "type": "array", "x-source": "edr_full_restricted", "x-source-path": "activity_kved", "items": { "type": "string" } }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}
