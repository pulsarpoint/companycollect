{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghana Company Profile",
  "description": "Country-specific company profile for Ghana. The official register is the ORC (Office of the Registrar of Companies, formerly the Registrar General's Department), keyed on the company registration number, with the TIN (Tax Identification Number, GRA) as the tax key. Company search and documents (incorporation, status report, annual returns) are delivered via the eServices portal — paid per transaction; the ORC/RGD hosts were firewalled from the investigation environment. VAT is registered under the TIN (no separate VAT number). Listed-company data + financials are OPEN via the Ghana Stock Exchange (GSE), keyed on the ticker. Currency GHS; English. Directors/shareholders are personal data (Data Protection Act 2012, Act 843) — redact. No ORC per-company values were captured; listed identity is from the GSE.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Ghana" },
    "country_slug": { "type": "string", "const": "ghana" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["registration_number"],
      "properties": {
        "registration_number": { "type": ["string", "null"], "description": "ORC company registration number. Primary id. Paid/firewalled (eServices).", "x-source": "orc_eservices", "x-source-path": "registration_number", "x-join-key": true, "x-freshness": "live", "x-access": "eservices_paid" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "tin": { "type": ["string", "null"], "description": "Tax Identification Number (GRA).", "x-source": "orc_eservices", "x-source-path": "tin" },
        "vat_id": { "type": ["string", "null"], "description": "Not separate — VAT registration is tied to the TIN.", "x-access": "not_available" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "orc_eservices", "x-source-path": "company_name", "x-source-alt": "gse_listed.company_name" },
        "company_type": { "type": ["string", "null"], "description": "Company limited by shares (Ltd/PLC) / by guarantee / unlimited / external.", "x-source": "orc_eservices", "x-source-path": "company_type" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "Active / Dissolved / Struck off / In receivership.", "x-source": "orc_eservices", "x-source-path": "status" },
        "incorporation_date": { "type": ["string", "null"], "format": "date", "x-source": "orc_eservices", "x-source-path": "incorporation_date" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "nature_of_business": { "type": ["string", "null"], "x-source": "orc_eservices", "x-source-path": "nature_of_business" },
        "gse_sector": { "type": ["string", "null"], "description": "GSE sector (listed).", "x-source": "gse_listed", "x-source-path": "sector" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "orc_eservices", "x-source-path": "registered_address" }
      }
    },
    "capital": {
      "type": "object",
      "description": "Stated capital (GHS), from paid ORC documents.",
      "x-source": "orc_eservices",
      "x-access": "paid",
      "properties": {
        "stated_capital": { "type": ["number", "null"], "x-source-path": "stated_capital" },
        "currency": { "type": "string", "const": "GHS" }
      }
    },
    "owners": {
      "type": "array",
      "description": "Shareholders / subscribers from the paid ORC documents. PERSONAL DATA when natural persons (Act 843) — REDACT.",
      "x-source": "orc_eservices",
      "x-source-path": "shareholders",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "shares": { "type": ["number", "null"] } } }
    },
    "officers": {
      "type": "array",
      "description": "Directors from the paid ORC documents. PERSONAL DATA (may include Ghana Card PIN) — REDACT.",
      "x-source": "orc_eservices",
      "x-source-path": "directors",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "listing": {
      "type": "object",
      "description": "Present only for GSE-listed companies (open).",
      "x-source": "gse_listed",
      "properties": {
        "gse_ticker": { "type": ["string", "null"], "x-source-path": "ticker" },
        "sector": { "type": ["string", "null"], "x-source-path": "sector" }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "Financial statements (GHS). OPEN via the GSE for listed companies; ORC annual returns (paid) for the rest.",
      "x-source": "gse_listed",
      "x-access": "open_for_listed_paid_otherwise",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": ["string", "null"] },
          "currency": { "type": "string", "const": "GHS" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
