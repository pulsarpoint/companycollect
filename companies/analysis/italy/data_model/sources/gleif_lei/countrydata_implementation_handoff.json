    "credential_env_vars": [],
    "note": "Public API (fair use) + downloadable golden copy (LEI-CDF XML / CSV). Filter to country=IT."
  },
  "transport": {
    "access_mode": "paginated_json_api",
    "base_url": "https://api.gleif.org/api/v1/lei-records",
