  "snapshot": {
    "strategy": "json_pages_or_golden_copy",
    "file_extension": ".json",
    "preserve_raw_download": true
  },
  "parsing": {
    "record_type_hint": "GleifLeiRecord",
    "date_formats": ["2006-01-02"],
    "datetime_formats": ["2006-01-02T15:04:05Z07:00"],
    "number_formats": [],
    "malformed_record_policy": "log_warn_and_continue",
    "notes": "Bridge to the register via entity.registeredAs (+ registrationAuthorityID RA000407). Honor registration.status (LAPSED=stale). Level-2 relationships optional."
  },
  "keys": {
    "primary_keys": ["lei"],
    "join_keys": ["lei", "entity.registeredAs", "legalName"],
    "dedupe_keys": ["lei"]
  },
  "mapping_rules": {
    "lei": "data[].attributes.lei.",
    "legal_name": "entity.legalName.name.",
    "registration_number_bridge": "entity.registeredAs (reconcile to REA/CF).",
    "legal_form": "entity.legalForm.id (ELF).",
    "owners": "relationships (direct/ultimate parent) where present."
  },
  "fixture_requirements": [
    "IT record with registeredAs populated (REA/CF bridge)",
    "record with LAPSED registration status",
    "record with a reported parent relationship (Level 2)",
    "record with registeredAs absent"
  ],
  "live_test_plan": {
    "smoke": "GET lei-records?filter[entity.legalAddress.country]=IT&page[size]=5; assert lei + legalName + (often) registeredAs.",
    "full": "Download the daily golden copy; filter country=IT; map LEI<->CF/REA; attach to the spine; optionally ingest Level-2 ownership."
  },
  "blockers": [
    "Subset only (LEI holders) — not a master.",
    "registeredAs format varies — reconcile to REA vs codice fiscale.",
    "No financials."
