    "compression": "zip (golden copy)",
    "encoding": "utf-8",
    "record_path": "data",
    "total_results_path": "meta.pagination.total",
    "pagination": {"type": "page_number", "page_param": "page[number]", "page_start": 1, "page_size": 200, "page_size_param": "page[size]", "next_page_path": "links.next", "note": "Filter filter[entity.legalAddress.country]=IT. For full set, use the daily golden copy and filter IT."},
