{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kenya Company Profile",
  "description": "Country-specific company profile for Kenya. The official register is the BRS (Business Registration Service), keyed on the company registration number (old C./CPR formats; new eCitizen PVT-XXXXXXX; BN for business names), but search and documents (CR12 directors/shareholders, status report, annual returns) are delivered via the eCitizen platform — login-gated and paid per transaction. The KRA PIN (Kenya Revenue Authority) is the tax id; VAT is registered under the PIN (no separate VAT number). Listed-company data + financials are OPEN via the NSE (Nairobi Securities Exchange), keyed on the ticker. Currency KES; English. CR12 directors/shareholders are personal data (Data Protection Act 2019) — redact. No BRS per-company values were captured; listed data is from NSE.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Kenya" },
    "country_slug": { "type": "string", "const": "kenya" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["registration_number"],
      "properties": {
        "registration_number": { "type": ["string", "null"], "description": "BRS company registration number (old C./CPR; new PVT-XXXXXXX). BN for business names. Primary id. Paid/gated via eCitizen.", "x-source": "brs_ecitizen", "x-source-path": "registration_number", "x-join-key": true, "x-freshness": "live", "x-access": "ecitizen_login_paid" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "kra_pin": { "type": ["string", "null"], "description": "Kenya Revenue Authority tax id.", "x-source": "brs_ecitizen", "x-source-path": "kra_pin" },
        "vat_id": { "type": ["string", "null"], "description": "Not separate — VAT is registered under the KRA PIN.", "x-access": "not_available" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "brs_ecitizen", "x-source-path": "company_name", "x-source-alt": "nse_listed.company_name" },
        "company_type": { "type": ["string", "null"], "description": "Private/Public Ltd / CLG / Business Name / LLP.", "x-source": "brs_ecitizen", "x-source-path": "company_type" }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_text": { "type": ["string", "null"], "description": "Active / Dormant / Dissolved / Struck off.", "x-source": "brs_ecitizen", "x-source-path": "status" },
        "registration_date": { "type": ["string", "null"], "format": "date", "x-source": "brs_ecitizen", "x-source-path": "registration_date" }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "nse_sector": { "type": ["string", "null"], "description": "NSE sector / market segment (listed).", "x-source": "nse_listed", "x-source-path": "sector_segment" }
      }
    },
    "registered_location": {
      "type": "object",
      "properties": {
        "registered_address": { "type": ["string", "null"], "x-source": "brs_ecitizen", "x-source-path": "registered_address" }
      }
    },
    "capital": {
      "type": "object",
      "description": "Nominal / issued capital (KES), from paid BRS documents.",
      "x-source": "brs_ecitizen",
      "x-access": "paid",
      "properties": {
        "nominal_capital": { "type": ["number", "null"], "x-source-path": "nominal_capital" },
        "currency": { "type": "string", "const": "KES" }
      }
    },
    "owners": {
      "type": "array",
      "description": "Shareholders from the paid BRS CR12. PERSONAL DATA when natural persons (Data Protection Act 2019) — REDACT.",
      "x-source": "brs_ecitizen",
      "x-source-path": "shareholders",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "shares": { "type": ["number", "null"] } } }
    },
    "officers": {
      "type": "array",
      "description": "Directors from the paid BRS CR12. PERSONAL DATA — REDACT.",
      "x-source": "brs_ecitizen",
      "x-source-path": "directors",
      "x-access": "paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "listing": {
      "type": "object",
      "description": "Present only for NSE-listed companies (open).",
      "x-source": "nse_listed",
      "properties": {
        "nse_ticker": { "type": ["string", "null"], "x-source-path": "ticker" },
        "sector_segment": { "type": ["string", "null"], "x-source-path": "sector_segment" }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "Annual returns / accounts (KES). PAID via BRS for all companies; OPEN via NSE for listed companies.",
      "x-source": "nse_listed",
      "x-access": "open_for_listed_paid_otherwise",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": ["string", "null"] },
          "revenue": { "type": ["number", "null"] },
          "profit": { "type": ["number", "null"] },
          "currency": { "type": "string", "const": "KES" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
