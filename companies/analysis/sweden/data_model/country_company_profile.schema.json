{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsarpoint/companycollect/sweden/country_company_profile.schema.json",
  "title": "Sweden Company Profile",
  "description": "Country-specific combined company profile for Sweden, built from the two official free sources launched 26 June 2025 under the EU Open Data Directive high-value-datasets rule: Bolagsverket Värdefulla datamängder (base data + iXBRL annual reports) and SCB Företagsregistret/FDB (register, workplaces, SNI, employee size-class, register flags). Join key across all sources is organisationsnummer.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Sweden" },
    "country_slug": { "type": "string", "const": "sweden" },
    "country_profile_version": {
      "type": "string",
      "description": "Date-stamp of the profile shape, e.g. 2026-06-13."
    },
    "registration": {
      "type": "object",
      "description": "Core identity and registration.",
      "required": ["organisationsnummer"],
      "properties": {
        "organisationsnummer": {
          "type": "string",
          "description": "10-digit Swedish organisation number, digits-only canonical form. Personnummer for sole traders.",
          "x-source": "bolagsverket_vdm|scb_fdb",
          "x-source-path": "organisationsnummer",
          "x-join-key": true
        },
        "organisationsnummer_display": {
          "type": "string",
          "description": "Display form NNNNNN-NNNN.",
          "x-source": "derived"
        },
        "vat_id": {
          "type": ["string", "null"],
          "description": "Swedish VAT number SE + orgnr + 01. Mark whether sourced or derived; treat as active only if the SCB VAT flag is set.",
          "x-source": "bolagsverket_vdm|scb_fdb(flag)|derived"
        },
        "vat_registered": {
          "type": ["boolean", "null"],
          "description": "VAT-register flag.",
          "x-source": "scb_fdb",
          "x-source-path": "foretag.moms_flagga"
        },
        "f_tax_registered": {
          "type": ["boolean", "null"],
          "description": "F-skatt (F-tax) approval — strong active-business signal.",
          "x-source": "scb_fdb",
          "x-source-path": "foretag.fskatt_flagga"
        },
        "employer_registered": {
          "type": ["boolean", "null"],
          "x-source": "scb_fdb",
          "x-source-path": "foretag.arbetsgivare_flagga"
        }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": {
          "type": "string",
          "description": "Registered legal name (Bolagsverket authoritative).",
          "x-source": "bolagsverket_vdm",
          "x-source-path": "organisationsnamn"
        },
        "normalized_name": { "type": "string", "x-source": "derived" },
        "name_scb": {
          "type": ["string", "null"],
          "description": "Company name as held by SCB (fallback / cross-check).",
          "x-source": "scb_fdb",
          "x-source-path": "foretag.foretagsnamn"
        },
        "legal_form": {
          "type": ["string", "null"],
          "description": "Aktiebolag (AB), Handelsbolag (HB), Kommanditbolag (KB), Enskild firma, Ekonomisk förening, ...",
          "x-source": "bolagsverket_vdm",
          "x-source-path": "juridisk_form"
        },
        "legal_form_scb": {
          "type": ["string", "null"],
          "x-source": "scb_fdb",
          "x-source-path": "foretag.juridisk_form"
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "status_raw": {
          "type": ["string", "null"],
          "description": "Raw Bolagsverket status (registrerad / avregistrerad / konkurs / likvidation).",
          "x-source": "bolagsverket_vdm",
          "x-source-path": "status"
        },
        "active": { "type": ["boolean", "null"], "x-source": "derived" },
        "incorporation_date": {
          "type": ["string", "null"],
          "format": "date",
          "x-source": "bolagsverket_vdm",
          "x-source-path": "registreringsdatum"
        },
        "dissolution_date": {
          "type": ["string", "null"],
          "format": "date",
          "x-source": "bolagsverket_vdm",
          "x-source-path": "avregistreringsdatum"
        }
      }
    },
    "activity": {
      "type": "object",
      "properties": {
        "sni_codes": {
          "type": "array",
          "description": "SNI 2025 industry codes (company-level). SCB is the fuller source.",
          "items": { "type": "string" },
          "x-source": "scb_fdb|bolagsverket_vdm",
          "x-source-path": "foretag.sni_kod / naringsgrenskod"
        },
        "employees_size_class": {
          "type": ["string", "null"],
          "description": "Employee size-class band (e.g. 1-4). Never an exact headcount.",
          "x-source": "scb_fdb",
          "x-source-path": "foretag.storleksklass_anstallda"
        }
      }
    },
    "registered_location": {
      "type": "object",
      "description": "Registered address (Bolagsverket) enriched with authoritative geography (SCB).",
      "properties": {
        "street_address": { "type": ["string", "null"], "x-source": "bolagsverket_vdm", "x-source-path": "postadress_organisation.gatuadress" },
        "postal_code": { "type": ["string", "null"], "x-source": "bolagsverket_vdm|scb_fdb" },
        "postal_town": { "type": ["string", "null"], "x-source": "bolagsverket_vdm|scb_fdb" },
        "municipality": { "type": ["string", "null"], "description": "kommun.", "x-source": "scb_fdb", "x-source-path": "foretag.kommun" },
        "county": { "type": ["string", "null"], "description": "län.", "x-source": "scb_fdb", "x-source-path": "foretag.lan" },
        "country": { "type": "string", "const": "Sweden" }
      }
    },
    "local_units": {
      "type": "array",
      "description": "Workplaces / local units (arbetsställen) — SCB-only, keyed by CFAR.",
      "x-source": "scb_fdb",
      "x-freshness": "nightly/weekly",
      "items": {
        "type": "object",
        "required": ["cfar"],
        "properties": {
          "cfar": { "type": "string", "description": "8-digit CFAR workplace id.", "x-source-path": "arbetsstalle.cfar_nummer" },
          "name": { "type": ["string", "null"], "x-source-path": "arbetsstalle.namn_adress" },
          "address": { "type": ["string", "null"] },
          "postal_code": { "type": ["string", "null"] },
          "postal_town": { "type": ["string", "null"] },
          "municipality": { "type": ["string", "null"] },
          "county": { "type": ["string", "null"] },
          "sni_codes": { "type": "array", "items": { "type": "string" }, "x-source-path": "arbetsstalle.sni_kod" },
          "employees_size_class": { "type": ["string", "null"] },
          "main_or_subsidiary": { "type": ["string", "null"], "description": "huvud- vs del-arbetsställe.", "x-source-path": "arbetsstalle.huvud_del" }
        }
      }
    },
    "financials": {
      "type": "array",
      "description": "Per-fiscal-year figures parsed from Bolagsverket iXBRL annual reports (K2/K3 taxonomy). Free coverage = digitally filed reports only.",
      "x-source": "bolagsverket_annual_reports",
      "x-freshness": "per filing",
      "x-access": "oauth_gated",
      "items": {
        "type": "object",
        "required": ["fiscal_year", "currency"],
        "properties": {
          "fiscal_year": { "type": "string", "x-source-path": "räkenskapsår" },
          "period_start": { "type": ["string", "null"], "format": "date" },
          "period_end": { "type": ["string", "null"], "format": "date" },
          "currency": { "type": "string", "description": "ISO 4217, usually SEK.", "x-source-path": "ixbrl:Valuta" },
          "accounting_framework": { "type": ["string", "null"], "description": "K2 or K3.", "x-source-path": "ixbrl:Regelverk" },
          "net_revenue": { "type": ["number", "null"], "x-source-path": "ixbrl:Nettoomsattning" },
          "operating_profit_ebit": { "type": ["number", "null"], "x-source-path": "ixbrl:Rorelseresultat" },
          "profit_after_financial_items": { "type": ["number", "null"], "x-source-path": "ixbrl:ResultatEfterFinansiellaPoster" },
          "net_profit": { "type": ["number", "null"], "x-source-path": "ixbrl:AretsResultat" },
          "total_assets": { "type": ["number", "null"], "x-source-path": "ixbrl:SummaTillgangar" },
          "total_equity": { "type": ["number", "null"], "x-source-path": "ixbrl:SummaEgetKapital" },
          "total_liabilities": { "type": ["number", "null"], "x-source-path": "ixbrl:SummaSkulder" },
          "audited": { "type": ["boolean", "null"], "x-source-path": "ixbrl:Revisor" },
          "document_id": { "type": ["string", "null"], "x-source-path": "dokumentlista[].dokumentId" },
          "raw_xbrl_concepts": { "type": ["object", "null"], "description": "Raw parsed iXBRL concept->value map for re-normalization." }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "Filed documents (annual reports) listed via /dokumentlista.",
      "x-source": "bolagsverket_annual_reports",
      "items": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string" },
          "document_type": { "type": ["string", "null"], "description": "e.g. årsredovisning." },
          "fiscal_year": { "type": ["string", "null"] }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "description": "One entry per source that contributed to this profile.",
      "items": {
        "type": "object",
        "required": ["source_slug", "source_name"],
        "properties": {
          "source_slug": { "type": "string" },
          "source_name": { "type": "string" },
          "source_url": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "access": { "type": ["string", "null"] },
          "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
          "freshness": { "type": ["string", "null"] }
        }
      }
    }
  }
}
