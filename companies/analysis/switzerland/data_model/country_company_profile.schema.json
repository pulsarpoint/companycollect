{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Switzerland Company Profile",
  "description": "Country-specific company profile for Switzerland. Identity is fully open via Zefix LINDAS Linked Data (SPARQL, no auth): UID, legal name, legal form (eCH-0097), registered address, municipality, website, business purpose. Keyed on the UID (CHE-xxx.xxx.xxx); VAT = UID + ' MWST'/'TVA'/'IVA'. Status, registered capital, and SOGC/officer history come from the credentialed (free) Zefix REST API / SOGC gazette. FINANCIALS ARE A STRUCTURAL GAP: Switzerland has no public filing obligation for private companies — annual accounts are open only for listed issuers (SIX) and regulated entities. Officers (paid extract / SOGC) and beneficial owners (no public register) are not in the open set.",
  "type": "object",
  "required": ["country", "country_slug", "registration", "source_provenance"],
  "properties": {
    "country": { "type": "string", "const": "Switzerland" },
    "country_slug": { "type": "string", "const": "switzerland" },
    "country_profile_version": { "type": "string" },
    "registration": {
      "type": "object",
      "required": ["uid"],
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unternehmens-Identifikationsnummer (CHE-xxx.xxx.xxx). Company id and universal join key.",
          "x-source": "zefix_lindas",
          "x-source-path": "schema:identifier[CompanyUID].value",
          "x-join-key": true,
          "x-access": "public"
        },
        "chid": { "type": ["string", "null"], "description": "Cantonal register id (CH…).", "x-source": "zefix_lindas", "x-source-path": "schema:identifier[CHID].value" },
        "ehraid": { "type": ["string", "null"], "description": "Zefix internal id.", "x-source": "zefix_lindas", "x-source-path": "schema:identifier[EHRAID]" }
      }
    },
    "tax_identifiers": {
      "type": "object",
      "properties": {
        "vat_id": { "type": ["string", "null"], "description": "UID + ' MWST'/'TVA'/'IVA' when VAT-registered.", "x-source": "zefix_lindas", "x-source-path": "derived from uid" }
      }
    },
    "legal_identity": {
      "type": "object",
      "properties": {
        "legal_name": { "type": ["string", "null"], "x-source": "zefix_lindas", "x-source-path": "schema:legalName" },
        "legal_form": { "type": ["string", "null"], "description": "eCH-0097 (AG, GmbH, Verein, …).", "x-source": "zefix_lindas", "x-source-path": "schema:additionalType" },
        "purpose": { "type": ["string", "null"], "description": "Business purpose (Zweck).", "x-source": "zefix_lindas", "x-source-path": "schema:description" },
        "website": { "type": ["string", "null"], "x-source": "zefix_lindas", "x-source-path": "schema:url" }
      }
    },
    "status": {
      "type": "object",
      "description": "Status not in LINDAS (≈ active set) — from the credentialed Zefix REST API.",
      "x-access": "free_credentialed",
      "properties": {
        "status": { "type": ["string", "null"], "x-source": "zefix_rest_api", "x-source-path": "status" }
      }
    },
    "registered_location": {
      "type": "object",
      "x-source": "zefix_lindas",
      "properties": {
        "street_address": { "type": ["string", "null"], "x-source-path": "schema:address.streetAddress" },
        "postal_code": { "type": ["string", "null"], "x-source-path": "schema:address.postalCode" },
        "locality": { "type": ["string", "null"], "x-source-path": "schema:address.addressLocality" },
        "municipality": { "type": ["string", "null"], "x-source-path": "admin:municipality" }
      }
    },
    "share_capital": {
      "type": "object",
      "description": "Registered nominal capital (not financial statements). Credentialed REST / paid extract.",
      "x-access": "free_credentialed",
      "properties": {
        "amount": { "type": ["number", "null"], "x-source": "zefix_rest_api", "x-source-path": "capitalNominal" },
        "currency": { "type": ["string", "null"], "x-source": "zefix_rest_api", "x-source-path": "capitalCurrency" }
      }
    },
    "officers": {
      "type": "array",
      "description": "PLANNING-ONLY. From SOGC events (free credentialed) or paid cantonal extract. PERSONAL DATA — redact.",
      "x-access": "credentialed_or_paid",
      "items": { "type": "object", "properties": { "name": { "type": "string", "x-source": "sogc_shab", "x-source-path": "persons[].name", "x-personal-data": true }, "role": { "type": ["string", "null"] } } }
    },
    "register_events": {
      "type": "array",
      "description": "SOGC gazette events (incorporation, mutations, dissolution). Free credentialed.",
      "x-source": "sogc_shab",
      "x-access": "free_credentialed",
      "items": {
        "type": "object",
        "properties": {
          "publication_date": { "type": ["string", "null"], "format": "date", "x-source-path": "publicationDate" },
          "event_type": { "type": ["string", "null"], "x-source-path": "mutationType" }
        }
      }
    },
    "financial_statements": {
      "type": "array",
      "description": "STRUCTURAL GAP. No public filing for private companies. Available ONLY for listed issuers (SIX) and regulated entities. EUR/CHF.",
      "x-access": "listed_only",
      "x-source": "six_listed_financials",
      "items": {
        "type": "object",
        "properties": {
          "fiscal_year": { "type": "integer", "x-source-path": "fiscal_year" },
          "balance_sheet": { "type": ["object", "null"], "x-source-path": "balance_sheet" },
          "income_statement": { "type": ["object", "null"], "x-source-path": "income_statement" },
          "currency": { "type": "string", "const": "CHF" }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_slug", "section"],
        "properties": {
          "source_slug": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "access": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}
