# Image tag used by all enrichment service images.
SERVICES_IMAGE_TAG=latest

# NATS
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_MAX_PAYLOAD=16777216

# Translation service/API/worker
TRANSLATION_SERVICE_PORT=8095
TRANSLATION_DEFAULT_PROVIDER=local
TRANSLATION_DEFAULT_MODEL=qwen3:6b
TRANSLATION_PROVIDER_LOCAL_BASE_URL=http://100.77.62.33:8888
TRANSLATION_PROVIDER_LOCAL_API_KEY=
TRANSLATION_PROVIDER_DEEPSEEK_BASE_URL=
TRANSLATION_PROVIDER_DEEPSEEK_API_KEY=
TRANSLATION_NATS_SUBJECT=brreg.translation.translate
TRANSLATION_NATS_QUEUE=brreg-translation
TRANSLATION_WORKER_MAX_CONCURRENT_REQUESTS=1

# Crawl service/API/worker
CRAWL_SERVICE_PORT=8096
CRAWL_SERVICE_LLM_MODEL=
CRAWL_SERVICE_LLM_BASE_URL=
CRAWL_SERVICE_LLM_API_KEY=
DOMAIN_CRAWLER_BROWSER_TYPE=chromium
DOMAIN_CRAWLER_CHROME_CHANNEL=chromium
DOMAIN_CRAWLER_HEADLESS=true
DOMAIN_CRAWLER_LIGHT_MODE=true
DOMAIN_SEARCH_EXCLUDED_DOMAINS=
DOMAIN_SEARCH_EXTRA_EXCLUDED_DOMAINS=
DOMAIN_SEARCH_ALLOWED_DOMAINS=
NATS_SUBJECT=brreg.domain.discover
NATS_QUEUE=brreg-domain-crawl
CRAWL_WORKER_MAX_CONCURRENT_REQUESTS=1

# Currency and financial services
CURRENCY_SERVICE_PORT=8097
BRREG_FINANCIAL_SERVICE_PORT=8098

