# CompanyCollect services deployment environment.
#
# Copy this file to .env next to deploy/services/docker-compose.yml on the
# remote server. Values here are safe examples; replace secrets and provider
# endpoints before running production services.

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------

# Docker image tag used by all service images in this stack.
# Use "latest" for simple MVP deployments or a "sha-..." tag for pinned deploys.
SERVICES_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# NATS
# -----------------------------------------------------------------------------

# Host ports exposed for NATS clients and the NATS monitoring endpoint.
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Maximum NATS payload in bytes. Translation/domain requests can be larger than
# the default when they include many records or crawl artifacts.
NATS_MAX_PAYLOAD=16777216

# Local directory for persisted NATS JetStream state on the remote server.
NATS_DATA_DIR=./nats-data

# Optional NATS client URL used when running service workers outside this compose
# network. In this compose stack, worker containers use nats://nats:4222.
NATS_URL=nats://companycollect:4222

# -----------------------------------------------------------------------------
# Translation API and NATS Worker
# -----------------------------------------------------------------------------

# Host port for the translation HTTP API.
TRANSLATION_SERVICE_PORT=8095

# Default LLM provider/model used when requests do not override them.
# provider values are arbitrary names mapped to TRANSLATION_PROVIDER_<NAME>_*.
TRANSLATION_DEFAULT_PROVIDER=local
TRANSLATION_DEFAULT_MODEL=qwen3:6b

# Legacy model alias still supported by the translation service.
BRREG_TRANSLATION_MODEL=

# LLM HTTP timeout for translation requests.
TRANSLATION_LLM_TIMEOUT_SECONDS=120

# Provider-specific OpenAI-compatible endpoints.
# provider=local -> TRANSLATION_PROVIDER_LOCAL_*
TRANSLATION_PROVIDER_LOCAL_BASE_URL=http://100.77.62.33:8888
TRANSLATION_PROVIDER_LOCAL_API_KEY=

# provider=deepseek -> TRANSLATION_PROVIDER_DEEPSEEK_*
TRANSLATION_PROVIDER_DEEPSEEK_BASE_URL=
TRANSLATION_PROVIDER_DEEPSEEK_API_KEY=

# Optional shared fallback endpoint/key used if provider-specific config is not
# set. Prefer provider-specific variables above for production.
TRANSLATION_LLM_BASE_URL=
TRANSLATION_LLM_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# Shared decryption key for DB-backed LLM provider credentials received from
# Corpscout. Use the same value as CORPSCOUT_LLM_PROVIDER_KEY_ENCRYPTION_KEY.
# Use a stable passphrase, or use base64:<32-byte-key> from: openssl rand -base64 32
LLM_PROVIDER_KEY_ENCRYPTION_KEY=

# Translation worker NATS subscription.
TRANSLATION_NATS_SUBJECT=brreg.translation.translate
TRANSLATION_NATS_QUEUE=brreg-translation
TRANSLATION_WORKER_MAX_CONCURRENT_REQUESTS=1

# Mock mode for local isolated tests. Keep disabled in production.
TRANSLATION_MOCK_ENABLED=false

# -----------------------------------------------------------------------------
# Crawl API and NATS Worker
# -----------------------------------------------------------------------------

# Host port for the crawl HTTP API.
CRAWL_SERVICE_PORT=8096

# Required OpenAI-compatible LLM endpoint used by page/search analysis.
CRAWL_SERVICE_LLM_MODEL=qwen3:6b
CRAWL_SERVICE_LLM_BASE_URL=http://100.77.62.33:8888
CRAWL_SERVICE_LLM_API_KEY=

# Optional Docker secret file path for CRAWL_SERVICE_LLM_API_KEY.
CRAWL_SERVICE_LLM_API_KEY_FILE=

# Disable reasoning/thinking mode for models that support chat_template_kwargs.
CRAWL_SERVICE_DISABLE_THINKING=true

# crawl4ai browser settings.
DOMAIN_CRAWLER_BROWSER_TYPE=chromium
DOMAIN_CRAWLER_CHROME_CHANNEL=chromium
DOMAIN_CRAWLER_HEADLESS=true
DOMAIN_CRAWLER_LIGHT_MODE=true
DOMAIN_CRAWLER_USE_MANAGED_BROWSER=false
DOMAIN_CRAWLER_ENABLE_STEALTH=true

# Candidate filtering.
# If DOMAIN_SEARCH_EXCLUDED_DOMAINS is set, it replaces the built-in directory
# and registry exclusion list. Leave empty to use the built-in list.
DOMAIN_SEARCH_EXCLUDED_DOMAINS=

# Additional domains to exclude on top of the active exclusion list.
DOMAIN_SEARCH_EXTRA_EXCLUDED_DOMAINS=

# Domains to allow even if they appear in the active exclusion list.
DOMAIN_SEARCH_ALLOWED_DOMAINS=

# Crawl worker NATS subscription.
NATS_SUBJECT=brreg.domain.discover
CRAWL_NATS_BRREG_DOMAIN_DISCOVERY_SUBJECT=brreg.domain.discover
CRAWL_NATS_SEARCH_FETCH_SUBJECT=brreg.domain.search.fetch
CRAWL_NATS_SEARCH_ANALYZE_SUBJECT=brreg.domain.search.analyze
NATS_QUEUE=brreg-domain-crawl
CRAWL_WORKER_MAX_CONCURRENT_REQUESTS=1

# Mock mode for local isolated tests. Keep disabled in production.
CRAWL_SERVICE_MODE=
CRAWL_SERVICE_MOCK_ENABLED=false

# -----------------------------------------------------------------------------
# Shared Mock Controls
# -----------------------------------------------------------------------------

# Used by both translation and crawl mock modes.
MOCK_SEED=brreg-e2e-v1
MOCK_PROFILE=mixed

# -----------------------------------------------------------------------------
# Currency Service
# -----------------------------------------------------------------------------

# Host port for the currency HTTP API.
CURRENCY_SERVICE_PORT=8097

# Internal listen address inside the container.
CURRENCY_SERVICE_LISTEN_ADDR=:8097

# Supported provider currently: ecb.
CURRENCY_SERVICE_PROVIDER=ecb

# Cache TTL for same-day exchange rates.
CURRENCY_SERVICE_TODAY_TTL=6h

# Upstream request timeout and max records accepted in one request.
CURRENCY_SERVICE_REQUEST_TIMEOUT=30s
CURRENCY_SERVICE_MAX_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# BRREG Financial Service
# -----------------------------------------------------------------------------

# Host port for the BRREG financial HTTP API.
BRREG_FINANCIAL_SERVICE_PORT=8098

# Internal listen address inside the container.
BRREG_FINANCIAL_SERVICE_LISTEN_ADDR=:8098

# Official BRREG base URL and service request limits.
BRREG_FINANCIAL_SERVICE_BASE_URL=https://data.brreg.no
BRREG_FINANCIAL_SERVICE_REQUEST_TIMEOUT=30s
BRREG_FINANCIAL_SERVICE_MAX_BATCH_SIZE=1000
