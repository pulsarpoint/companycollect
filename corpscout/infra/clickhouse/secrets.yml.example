---
# Copy to secrets.yml (git-ignored) next to install.yml. Loaded via vars_files.
clickhouse_password: "change-me"
# Backblaze B2 application key for the clickhouse-backup sidecar. Create it
# restricted to the backup bucket with the capabilities listBuckets, listFiles,
# readFiles, writeFiles, deleteFiles — nothing account-wide.
backblaze_key_id: "your-key-id"
backblaze_key_name: "clickhouse-backup-main-ch-backup"
backblaze_app_key: "your-app-key"
