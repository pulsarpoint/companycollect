# Standalone translator service.
# Copy to .env and export before running the service, or source it in your shell.

TRANSLATOR_CONFIG_FILE=config/translator.json

# Temporal frontend. This name intentionally matches dagster_v3/.env.example.
TEMPORAL_ADDRESS=companycollect:7233
TRANSLATOR_MAX_BATCHES_PER_RUN=500

# ClickHouse connection. These names intentionally match dagster_v3/.env.example
# so both services can share the same environment file.
CLICKHOUSE_HOST=companycollect
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=corpscout
CLICKHOUSE_SECURE=false

# Leave disabled unless tests should hit the real ClickHouse/LLM.
TRANSLATOR_INTEGRATION_TESTS=false

# Local OpenAI-compatible LLM endpoint.
TRANSLATION_PROVIDER_LOCAL_BASE_URL=http://100.77.62.33:8888/v1
TRANSLATION_PROVIDER_LOCAL_MODEL=qwen3:6b
TRANSLATION_PROVIDER_LOCAL_API_KEY=not-needed
