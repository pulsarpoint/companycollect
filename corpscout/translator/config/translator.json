{
  "server": {
    "listen_address": ":8080"
  },
  "clickhouse": {
    "native_url_env": "CLICKHOUSE_NATIVE_URL"
  },
  "temporal": {
    "host_port": "localhost:7233",
    "host_port_env": "TRANSLATOR_TEMPORAL_HOST",
    "namespace": "default",
    "namespace_env": "TRANSLATOR_TEMPORAL_NAMESPACE",
    "task_queue": "translator",
    "task_queue_env": "TRANSLATOR_TEMPORAL_TASK_QUEUE",
    "batch_size": 50,
    "batch_size_env": "TRANSLATOR_BATCH_SIZE",
    "timeout_seconds": 120,
    "timeout_seconds_env": "TRANSLATOR_TIMEOUT_SECONDS"
  },
  "endpoints": {
    "local_llm": {
      "model": "qwen3:6b",
      "model_env": "TRANSLATION_PROVIDER_LOCAL_MODEL",
      "base_url": "http://100.77.62.33:8888/v1",
      "base_url_env": "TRANSLATION_PROVIDER_LOCAL_BASE_URL",
      "api_key_env": "TRANSLATION_PROVIDER_LOCAL_API_KEY",
      "api_key_default": "not-needed",
      "max_tokens": 32768,
      "prompt_data": {
        "source_language": "Norwegian",
        "target_language": "English"
      },
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  },
  "sources": {
    "norway_brreg": {
      "queue_path": "data/translator/norway_brreg.duckdb",
      "endpoint_id": "local_llm"
    }
  }
}
