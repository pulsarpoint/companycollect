# MANAGED BY ANSIBLE (roles/ctlog) — the single EnvironmentFile for ctlog@.service.
# root:0600; systemd (PID 1) reads it before dropping to the service user, so the
# ctlog user itself never needs read access to the password.
CTLOG_CLICKHOUSE_ADDR={{ ctlog_clickhouse_addr }}
CTLOG_CLICKHOUSE_DATABASE={{ ctlog_clickhouse_database }}
CTLOG_CLICKHOUSE_USER={{ ctlog_clickhouse_user }}
CTLOG_CLICKHOUSE_PASSWORD={{ ctlog_clickhouse_password }}
CTLOG_CONTROL_DB_PATH={{ ctlog_data_dir }}/ctlog-control.db
CTLOG_BATCH_SIZE={{ ctlog_batch_size }}
CTLOG_FETCH_PARALLEL={{ ctlog_fetch_parallel }}
CTLOG_WRITE_BATCH_SIZE={{ ctlog_write_batch_size }}
