# Optional: scripts/dagster-dev.sh defaults DAGSTER_HOME to this project root.
DAGSTER_HOME=/absolute/path/to/companycollect/corpscout/services/dagster_v3
# Local development uses the loopback-only PostgreSQL service in
# docker-compose.local.yml. The deployed server keeps its own .env value that
# reaches the shared `dagster` database through PgBouncer.
DAGSTER_PG_URL=postgresql://dagster_local:dagster_local@127.0.0.1:55432/dagster_local
# Optional override; scripts/dagster-dev.sh defaults to 100.
DAGSTER_DB_POOL_MAX_OVERFLOW=100

# Webhook for run-failure and stale-run alerts (Slack incoming-webhook
# compatible; alert sensors POST {"text": ...}). Unset = alerts only logged.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# Alert when a STARTED run emits no Dagster events for this many seconds.
DAGSTER_STALE_RUN_IDLE_SECONDS=3600

# DuckDB runtime settings used by Dagster DuckDBResource assets.
# Large monthly/bulk sources such as Brazil RFB need enough temp spill space.
# By default each DuckDB database uses a project-local data/duckdb_tmp directory.
# Override only when you have a mounted disk visible inside the Dagster runtime.
# DUCKDB_TEMP_DIRECTORY=data/duckdb_tmp
DUCKDB_MAX_TEMP_DIRECTORY_SIZE=150GiB
DUCKDB_THREADS=4
# Optional: cap DuckDB process memory. Leave unset to let DuckDB choose a default.
# DUCKDB_MEMORY_LIMIT=8GiB
# Optional: default is false for lower memory pressure on bulk transforms.
# DUCKDB_PRESERVE_INSERTION_ORDER=false

TEMPORAL_ADDRESS=companycollect:7233
TRANSLATOR_API_URL=http://localhost:8080
TRANSLATION_PROVIDER_LOCAL_BASE_URL=http://100.77.62.33:8888/v1
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Recorded as model_provider on every row a DeepSeek-compatible endpoint
# produces. Change it when the endpoint is not DeepSeek itself.
DEEPSEEK_PROVIDER=deepseek
TRANSLATION_PROVIDER_LOCAL_MODEL=qwen3:6b
TRANSLATION_PROVIDER_LOCAL_API_KEY=not-needed
TRANSLATION_PROVIDER_MAX_TOKENS=2048
TRANSLATION_PROVIDER_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
# RUN_TRANSLATION_INTEGRATION_TESTS=1

# ClickHouse connection. Dagster's ClickhouseResource uses the native protocol
# on CLICKHOUSE_NATIVE_PORT. Legacy clickhouse-connect clients still use HTTP
# on CLICKHOUSE_HTTP_PORT.
CLICKHOUSE_HOST=companycollect
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=corpscout
CLICKHOUSE_SECURE=false

# S3-compatible raw snapshot storage.
CORPSCOUT_S3_ENDPOINT=http://companycollect:9000
CORPSCOUT_S3_ACCESS_KEY=change-me
CORPSCOUT_S3_SECRET_KEY=change-me

# Required by the four-worker Ratsit scan. The direct worker uses no proxy;
# these three values must be non-empty, distinct CloakBrowser proxy URLs.
crawl_proxy1=http://user:password@proxy1.example:8080
crawl_proxy2=http://user:password@proxy2.example:8080
crawl_proxy3=http://user:password@proxy3.example:8080

# UK Companies House API key.
COMPANY_HOUSE=change-me

# Directory containing versioned GeoLite2-City_* and GeoLite2-ASN_* folders.
MAXMIND_DATABASE_DIRECTORY=/path/to/geoip

# Production embedder (vLLM, Qwen3-Embedding-8B) — used by the NACE classifier.
COMMONCRAWL_EMBED_BASE_URL=http://<embed-host>:8000/v1
COMMONCRAWL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
COMMONCRAWL_EMBED_API_KEY=x

# Optional: pin contact-extraction DNS validation to specific resolver IPs
# (comma-separated). When set, validation uses plain stub queries against only
# these servers instead of the default parent-zone walk — point it at a
# dedicated recursive resolver (e.g. unbound) if the local resolver path is
# flaky or rate-limits sustained lookups. Unset = current default behavior.
#CONTACT_EXTRACTION_DNS_SERVERS=100.64.0.53

# Bolagsverket Valuable Datasets API (targeted, on-demand Sweden refreshes only)
BOLAGSVERKET_VDM_CLIENT_ID=
BOLAGSVERKET_VDM_CLIENT_SECRET=


POSTGRES_PASSWORD=538af795845ff05cd0a9596e6e9fff3782d9d49ad9421a90374e424c4660569b
BACKOFFICE_OWNER_PASSWORD=0678c32a82385adbae29da94a03368c1c528dcfa00192e2918f0ef43e752eb77
BACKOFFICE_APP_PASSWORD=f49bc38109fda0c23531fa30860f21ca405e8e14da480eb36af13fa16ef8952f
BACKOFFICE_DAGSTER_PASSWORD=6516479c7e349e1cb894c3f00836243842b2b2dd7e5c5db5df534c712fd2ab34
