{
  "manifest_version": 3,
  "name": "Technology API Detector",
  "description": "Detects website technologies and sends them to a local API.",
  "version": "1.3.0",
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["cookies", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "resources": ["js/dom.js", "js/js.js"]
    }
  ]
}
