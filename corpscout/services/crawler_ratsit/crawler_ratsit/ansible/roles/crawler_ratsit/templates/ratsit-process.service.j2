# MANAGED BY ANSIBLE (roles/crawler_ratsit).
[Unit]
Description=Ratsit browser and Temporal crawler process
PartOf=graphical-session.target
After=graphical-session.target network-online.target
Wants=network-online.target
ConditionEnvironment=DISPLAY
ConditionEnvironment=XAUTHORITY
ConditionPathExists={{ crawler_ratsit_environment_file }}
ConditionPathExists={{ crawler_ratsit_process_config_file }}
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory={{ crawler_ratsit_deploy_dir }}
Environment=HOME={{ crawler_ratsit_service_home }}
Environment=CLOAKBROWSER_CACHE_DIR={{ crawler_ratsit_cache_dir }}
Environment=PYTHONUNBUFFERED=1
EnvironmentFile={{ crawler_ratsit_environment_file }}
ExecStart={{ crawler_ratsit_deploy_dir }}/.venv/bin/python -m crawler_ratsit.process --config {{ crawler_ratsit_process_config_file }}

Restart=always
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077

NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
