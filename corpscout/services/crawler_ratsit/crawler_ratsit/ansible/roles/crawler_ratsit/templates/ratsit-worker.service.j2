# MANAGED BY ANSIBLE (roles/crawler_ratsit).
[Unit]
Description=Ratsit Temporal crawler worker
ConditionPathExists={{ crawler_ratsit_environment_file }}
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory={{ crawler_ratsit_deploy_dir }}
Environment=HOME={{ crawler_ratsit_service_home }}
Environment=PYTHONUNBUFFERED=1
EnvironmentFile={{ crawler_ratsit_environment_file }}
ExecStart={{ crawler_ratsit_deploy_dir }}/.venv/bin/python -m crawler_ratsit.worker

Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077

NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
