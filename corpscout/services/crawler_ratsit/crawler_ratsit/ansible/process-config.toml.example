[process]
state_directory = "/var/lib/ratsit-process"
headless = false

[limits]
# Per-browser pacing. 0.2 starts at one activity every five seconds.
per_browser_activities_per_second = 0.2

# Temporal task-queue-wide pacing. Keep this explicit and identical on every
# host polling ratsit-http; do not derive it from the number of browsers.
task_queue_activities_per_second = 0.2

[[browsers]]
id = "direct"
enabled = true

# Add one entry per fixed proxy. The real process-config.toml is ignored and
# must have mode 0600 because proxy URLs may contain credentials.
# [[browsers]]
# id = "proxy1"
# enabled = true
# proxy_url = "http://user:password@proxy1.example:8080"
