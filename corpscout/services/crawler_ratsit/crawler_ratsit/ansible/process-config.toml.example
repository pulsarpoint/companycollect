[process]
state_directory = "/var/lib/ratsit-process"
headless = false

[limits]
# Per-browser pacing. 0.5 starts at one activity every two seconds.
per_browser_activities_per_second = 0.5

# Four enabled browsers at 0.5 requests/second allow a theoretical aggregate
# of 2.0. Keep this identical on every process polling ratsit-http-v2.
task_queue_activities_per_second = 2.0

[[browsers]]
id = "direct"
enabled = true

# Add one entry per fixed proxy. The real process-config.toml is ignored and
# must have mode 0600 because proxy URLs may contain credentials.
# [[browsers]]
# id = "proxy1"
# enabled = true
# proxy_url = "http://user:password@proxy1.example:8080"
