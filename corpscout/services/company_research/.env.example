# Required for automatic discovery, instruction selection and site-info with direct DeepSeek.
DEEPSEEK=
# Required instead when the request sets api=openrouter.
OPENROUTER_API_KEY=
# Optional on localhost; required by the launcher for REST on other interfaces.
CRAWL_API_TOKEN=
# Used with --transport nats or both; --nats-url overrides this.
NATS_URL=nats://127.0.0.1:4222
