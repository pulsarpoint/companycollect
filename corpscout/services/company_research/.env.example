# Required for automatic discovery, instruction selection and site-info with direct DeepSeek.
DEEPSEEK=
# Required instead when the request sets api=openrouter.
OPENROUTER_API_KEY=
# Optional on localhost; required by the launcher for REST on other interfaces.
CRAWL_API_TOKEN=
# Used with --transport nats or both; --nats-url overrides this.
NATS_URL=nats://127.0.0.1:4222
# Set a bucket to enable NATS S3 results and durable completion events.
CRAWL_S3_BUCKET=
CRAWL_S3_PREFIX=company-crawls
# Leave empty for AWS S3; for RustFS use http://rustfs:9000.
CRAWL_S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Used by company-research-clickhouse. Native ClickHouse URL, kept private.
CLICKHOUSE_NATIVE_URL=
