# Managed by Ansible.
[Unit]
Description=Corpscout company crawl REST API and JetStream worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User={{ company_research_user }}
Group={{ company_research_user }}
WorkingDirectory={{ company_research_deploy_dir }}/current
EnvironmentFile={{ company_research_env_file }}
{% for name, value in company_research_runtime_environment.items() %}
Environment="{{ name }}={{ value }}"
{% endfor %}
ExecStart={{ company_research_deploy_dir }}/current/.venv/bin/company-research-service \
    --transport {{ company_research_transport }} \
    --output-dir {{ company_research_output_dir }} \
    --host {{ company_research_listen_host }} --port {{ company_research_port }} \
    --concurrency {{ company_research_concurrency }} --max-pending {{ company_research_max_pending }} \
    --nats-stream {{ company_research_nats_stream }} \
    --nats-subject {{ company_research_nats_subject }} \
    --nats-result-stream {{ company_research_nats_result_stream }} \
    --nats-result-subject {{ company_research_nats_result_subject }} \
    --nats-result-max-age {{ company_research_nats_result_max_age }} \
    --nats-durable {{ company_research_nats_durable }}{% if company_research_nats_create_stream %} --create-stream{% endif %}

Restart=on-failure
RestartSec=10s
TimeoutStopSec=90s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ company_research_state_dir }} {{ company_research_cache_dir }}

[Install]
WantedBy=multi-user.target
