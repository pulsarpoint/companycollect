# Managed by Ansible.
[Unit]
Description=Corpscout company crawl REST API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User={{ company_research_user }}
Group={{ company_research_user }}
WorkingDirectory={{ company_research_deploy_dir }}/current
EnvironmentFile={{ company_research_env_file }}
{% for name, value in company_research_runtime_environment.items() %}
Environment="{{ name }}={{ value }}"
{% endfor %}
ExecStart={{ company_research_deploy_dir }}/current/.venv/bin/company-research-service \
    --output-dir {{ company_research_output_dir }} \
    --host {{ company_research_listen_host }} --port {{ company_research_port }} \
    --concurrency {{ company_research_concurrency }} --max-pending {{ company_research_max_pending }}

Restart=on-failure
RestartSec=10s
TimeoutStopSec=90s
# Allow crawl cancellation to release external browser leases.
KillMode=mixed
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ company_research_state_dir }} {{ company_research_cache_dir }}

[Install]
WantedBy=multi-user.target
