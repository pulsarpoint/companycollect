---
# Copy to secrets.yml (git-ignored), chmod 600, then replace these values.
company_research_deepseek: ""
company_research_openrouter: ""
company_research_api_token: "replace-with-a-random-token"
# S3 is required by the default human-assistance deployment; provision the bucket first.
# For local-only operation, set company_research_human_enabled: false in vars.yml.
# company_research_s3_bucket: crawls
# company_research_s3_endpoint_url: http://rustfs:9000
# company_research_s3_access_key: ""
# company_research_s3_secret_key: ""

# Separate browser-service credential; must match its deployment.
company_research_browser_api_token: "replace-with-the-browser-service-token"
