---
# Copy to secrets.yml (git-ignored), chmod 600, then replace these values.
crawler_service_deepseek: ""
crawler_service_openrouter: ""
crawler_service_api_token: "replace-with-a-random-token"
# S3 is required by the default human-assistance deployment; provision the bucket first.
# For local-only operation, set crawler_service_human_enabled: false in vars.yml.
# crawler_service_s3_bucket: crawls
# crawler_service_s3_endpoint_url: http://rustfs:9000
# crawler_service_s3_access_key: ""
# crawler_service_s3_secret_key: ""

# Separate browser-service credential; must match its deployment.
crawler_service_browser_api_token: "replace-with-the-browser-service-token"
