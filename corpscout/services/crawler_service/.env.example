# Shared LLM master key: exactly 64 hex characters, matching Backoffice
# CRAWLER_LLM_ENCRYPTION_KEY and browser service BROWSER_LLM_ENCRYPTION_KEY.
# Required for encrypted per-request profiles; provider keys stay in Backoffice's database.
CRAWLER_LLM_ENCRYPTION_KEY=
# Legacy direct requests and CLI commands without an encrypted LLM profile only.
# Used for automatic discovery, instruction selection and site-info with direct DeepSeek.
DEEPSEEK=
# Legacy alternative when a request without an LLM profile sets api=openrouter.
OPENROUTER_API_KEY=
# Optional on localhost; required by the launcher for REST on other interfaces.
CRAWL_API_TOKEN=
# Interactive retries and search verification. Requires S3; browser service owns Xvfb.
CRAWL_HUMAN_ENABLED=false
# Run bounded CAPTCHA agent attempts before the 10-second failure window.
# Requires CRAWL_HUMAN_ENABLED=true and DEEPSEEK on the browser service.
CRAWL_CHALLENGE_AGENT_ENABLED=false
CRAWL_CHALLENGE_AGENT_MAX_RUNS=3
# Independent browser service; required for scans and the collection CLI.
BROWSER_API_URL=http://127.0.0.1:8081
BROWSER_API_TOKEN=
CRAWL_MANUAL_CONCURRENCY=2
# Set a bucket to enable service S3 results.
CRAWL_S3_BUCKET=
CRAWL_S3_PREFIX=company-crawls
# Leave empty for AWS S3; for RustFS use http://rustfs:9000.
CRAWL_S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Required for API admission and result publication. Same inventory as CLICKHOUSE_RESULTS_NATIVE_URL.
# Native registration credentials need SELECT/INSERT on domains, websites and pages.
CLICKHOUSE_NATIVE_URL=

# Same PostgreSQL database as Dagster inventory publishers; coordinates parent writes.
PROCESSING_PG_URL=
INVENTORY_LOCK_TIMEOUT_MS=30000

# Dedicated native result writer; URL-encode the username/password in this DSN.
# Needs SELECT on domains/websites/pages and INSERT on the six result tables.
# Registry searches still use CLICKHOUSE_URL with CLICKHOUSE_USER/PASSWORD.
CLICKHOUSE_RESULTS_NATIVE_URL=

# Compact delivered SQLite payloads and expire old status events after one day.
CRAWL_SQLITE_RETENTION_DAYS=1
