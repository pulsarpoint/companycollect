browser_service_api_token: "replace-with-a-random-token-at-least-32-characters"
# Optional: enables the CAPTCHA assistance agent.
browser_service_deepseek_api_key: ""
browser_service_openrouter_api_key: ""

# Optional named Brave Ask routes (one direct route is always available).
browser_service_crawl_proxy1: ""
browser_service_crawl_proxy2: ""
browser_service_crawl_proxy3: ""

# Same 64-character hexadecimal key as Backoffice CRAWLER_LLM_ENCRYPTION_KEY.
browser_service_llm_encryption_key: "replace-with-32-random-bytes-as-hex"
