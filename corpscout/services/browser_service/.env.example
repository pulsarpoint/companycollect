BROWSER_API_TOKEN=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=8081
BROWSER_STATE_DIR=./browser-state
BROWSER_MAX_BROWSERS=6
BROWSER_SESSION_RETENTION_DAYS=7
# Optional closed Chromium user-data directory; copied only for new sessions.
BROWSER_BASE_PROFILE=
BROWSER_IDLE_TIMEOUT_SECONDS=120
# Optional: enables operator-triggered CAPTCHA assistance with DeepSeek V4.1 Flash.
DEEPSEEK=
OPENROUTER_API_KEY=

# Optional named routes for Brave Ask. Credentials stay in browser-service.
BROWSER_CRAWL_PROXY1=
BROWSER_CRAWL_PROXY2=
BROWSER_CRAWL_PROXY3=
