# ClickHouse read-only access (HTTP interface). Copy to .env and fill in.
CLICKHOUSE_URL=http://companycollect:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=corpscout

# Dedicated account granted the append-only person-correction and
# company-domain review writer roles.
CLICKHOUSE_WRITE_USER=backoffice_person_correction
CLICKHOUSE_WRITE_PASSWORD=change-me-separately

# Transactional backoffice PostgreSQL. Use the owner URL only for migrations;
# the application and Dagster each have a narrower role.
BACKOFFICE_POSTGRES_URL=postgres://corpscout_backoffice_app:change-me@192.168.88.169:5432/corpscout_backoffice?sslmode=disable
BACKOFFICE_POSTGRES_MIGRATE_URL=postgres://corpscout_backoffice_owner:change-me@192.168.88.169:5432/corpscout_backoffice?sslmode=disable
BACKOFFICE_POSTGRES_DAGSTER_URL=postgres://corpscout_backoffice_dagster:change-me@192.168.88.169:5432/corpscout_backoffice?sslmode=disable

# Optional identifier stored with company-domain review decisions.
# COMPANY_DOMAIN_REVIEWER=local-backoffice
