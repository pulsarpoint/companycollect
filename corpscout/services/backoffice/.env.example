# ClickHouse read-only access (HTTP interface). Copy to .env and fill in.
CLICKHOUSE_URL=http://companycollect:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=corpscout

# Correction-ledger writes use the same CLICKHOUSE_USER/CLICKHOUSE_PASSWORD as
# reads and as the Dagster pipelines (no separate writer account).

# Transactional backoffice PostgreSQL. Use the owner URL only for migrations;
# the application and Dagster each have a narrower role.
BACKOFFICE_POSTGRES_URL=postgres://corpscout_backoffice_app:change-me@192.168.88.147:5432/corpscout_backoffice?sslmode=disable
BACKOFFICE_POSTGRES_MIGRATE_URL=postgres://corpscout_backoffice_owner:change-me@192.168.88.147:5432/corpscout_backoffice?sslmode=disable
BACKOFFICE_POSTGRES_DAGSTER_URL=postgres://corpscout_backoffice_dagster:change-me@192.168.88.147:5432/corpscout_backoffice?sslmode=disable

# Connections the backoffice keeps open to the review-queue PostgreSQL.
# BACKOFFICE_POSTGRES_POOL_MAX=5

# Dagster GraphQL, used by the Sweden company-info Pipeline page to read run
# state and to launch runs with explicit config. DAGSTER_UI_URL is only needed
# when the browser cannot reach the same host the backoffice does (run links are
# otherwise derived from DAGSTER_GRAPHQL_URL by dropping /graphql).
DAGSTER_GRAPHQL_URL=http://dagster:3000/graphql
# DAGSTER_UI_URL=http://companycollect:3000
# Optional server-side operator identifier written to Backoffice-triggered
# Dagster run tags. Browser form values cannot override it.
# BACKOFFICE_OPERATOR=local-backoffice
# Optional code-generation override when the runtime URL is not reachable from
# the developer shell. Used only by `pnpm dagster:codegen`.
# DAGSTER_GRAPHQL_SCHEMA_URL=http://127.0.0.1:43125/graphql

# Optional identifier stored with company-domain review decisions.
# COMPANY_DOMAIN_REVIEWER=local-backoffice
