# Shared config for the complete Common Crawl processor.
#
# Copy this file to cc-processor/.env, fill it in, and protect it:
#   cp .env.example .env
#   chmod 0600 .env
#
# Keep one .env at the cc-processor root. `make catalog` passes it to the Python builder. Before invoking
# a component directly, export this same file with `set -a; source .env; set +a` from this directory.
# Values such as OUT_BASE_DIR are host-specific: use catalog-build storage on wappalyzer and processing
# storage on commoncrawl2. Never commit .env or copy credentials into component directories.
#
# The embedding endpoint below is the SINGLE SOURCE OF TRUTH for the served model — read by BOTH:
#   - the Go cc-enrich-worker; and
#   - the jobs that create NACE and page-type reference embeddings (migrations 044/045).
#
# Keep them identical: the reference vectors and the page vectors MUST come from the same model,
# or cosine scores are meaningless. Swap the model here -> re-materialize the reference assets
# (`dg launch --assets nace_category_embeddings_clickhouse,page_type_exemplars_clickhouse`) AND
# re-run the worker.
#
# The WARC catalog builder needs only the RustFS settings and OUT_BASE_DIR. It does not use embedding,
# ClickHouse, or Common Crawl WARC credentials because it queries the official URL-index Parquets.

# --- RustFS authoritative catalog storage (builder writes; enrichment worker reads) ---
# The builder and worker append <crawl>/pagesN automatically. Do not include either component in the
# base URI. Each committed prefix contains only catalog.duckdb and ready.json. Workers verify and cache it at
# <OUT_BASE_DIR>/<crawl>/warc-index/pagesN/catalog.duckdb with catalog.duckdb.sha256 beside it.
# CORPSCOUT_S3_ENDPOINT must be reachable from whichever machine is running the command.
CORPSCOUT_S3_ENDPOINT=http://rustfs:9000
CORPSCOUT_S3_ACCESS_KEY=
CORPSCOUT_S3_SECRET_KEY=
CORPSCOUT_S3_REGION=us-east-1
COMMONCRAWL_CATALOG_S3_BASE=s3://crawls/commoncrawl/catalogs

# --- Embedding endpoint (industry/embed only; OpenAI-compatible, e.g. vLLM over Tailscale) ---
COMMONCRAWL_EMBED_BASE_URL=http://embed-host:8000/v1
COMMONCRAWL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
COMMONCRAWL_EMBED_API_KEY=x
COMMONCRAWL_EMBED_MAX_CHARS=2000

# --- ClickHouse: industry reads references here and the loader writes processor results here ---
CLICKHOUSE_HOST=companycollect
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=corpscout

# --- Common Crawl WARC source (cc-enrich-worker only) ---
# Signed S3 is preferred on EC2. An instance role can replace explicit keys; leave the keys blank then.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Local catalog and processing storage ---
# Required. For `make catalog`, this is the builder's manifests/candidates/catalog root unless --base is
# supplied directly. For a worker run, it is the catalog cache and output root. Processing
# output lives below <base>/<crawl>/warc/pagesN/; vectors live below <base>/<crawl>/embedding/warc/pagesN/.
# Use an absolute path with enough space for the catalog, Parquet output, and temporary complete WARCs.
OUT_BASE_DIR=/opt/companycollect/corpscout/commoncrawl/data

# CRAWL intentionally has no default: pass `CRAWL=...` to `make catalog` and `--crawl-id ...` to the worker.
