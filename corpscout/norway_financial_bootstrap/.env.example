# Temporal frontend used by both the starter and worker.
TEMPORAL_ADDRESS=companycollect:7233

# S3-compatible object storage used for fixed Norway BRREG bootstrap paths.
CORPSCOUT_S3_ENDPOINT=http://localhost:9000
CORPSCOUT_S3_ACCESS_KEY=change-me
CORPSCOUT_S3_SECRET_KEY=change-me

# ClickHouse source for bootstrap candidates.
# The database/table are fixed in code: corpscout.no_companies.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# Worker logging.
NORWAY_FINANCIAL_BOOTSTRAP_LOG_LEVEL=INFO
