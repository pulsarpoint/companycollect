# Shared config for the CommonCrawl pipeline. Copy to commoncrawl/.env (gitignored) and fill in.
#
# The embedding endpoint below is the SINGLE SOURCE OF TRUTH for the served model — read by BOTH:
#   - the Go cc-enrich-worker (embeds pages)         -> cc-crawl loads this file
#   - the dagster reference-embedding assets         -> dagster_v3/scripts/dagster-dev.sh sources this
#     (nace_category_embeddings / page_type_exemplars, migrations 044/045)
#
# Keep them identical: the reference vectors and the page vectors MUST come from the same model,
# or cosine scores are meaningless. Swap the model here -> re-materialize the reference assets
# (`dg launch --assets nace_category_embeddings_clickhouse,page_type_exemplars_clickhouse`) AND
# re-run the worker.
#
# (The downloader's embedded index builder needs none of these.)

# --- Embedding endpoint (OpenAI-compatible API; e.g. vLLM on the rented GPU over Tailscale) ---
COMMONCRAWL_EMBED_BASE_URL=http://<embed-host>:8000/v1
COMMONCRAWL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
COMMONCRAWL_EMBED_API_KEY=x
COMMONCRAWL_EMBED_MAX_CHARS=2000

# --- ClickHouse (corpscout DB): the worker loads results here; dagster exports the ref tables here ---
CLICKHOUSE_HOST=companycollect
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=corpscout

# --- AWS (signed S3 for CommonCrawl WARC byte-range fetch) — cc-download-worker only ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Local-network RustFS — downloader destination and cc-enrich-worker input ---
CORPSCOUT_S3_ENDPOINT=http://rustfs:9000
CORPSCOUT_S3_ACCESS_KEY=
CORPSCOUT_S3_SECRET_KEY=
CORPSCOUT_S3_BUCKET=crawls
CORPSCOUT_S3_REGION=us-east-1

# --- cc-crawl orchestration ---
# Output root — REQUIRED. Passed as `-base <dir>` or via this env (the -base default); cc-crawl and a
# standalone enrichment worker HARD-FAIL if neither is set. The downloader otherwise uses `data`. All output
# for a crawl lives under <base>/<crawl>/ so different crawls never collide: crawl/ holds
# per-part output + logs, embedding/ holds the vector tree. Absolute path recommended.
OUT_BASE_DIR=/opt/companycollect/corpscout/commoncrawl/data

# Bare-metal raw downloader worklist builder. The downloader container includes this dependency.
CC_DOWNLOAD_PYTHON=python3
