DAGSTER_HOME=/Users/graovic/pulsarpoint/ppoint/companycollect/corpscout/dagster_v3
DAGSTER_PG_URL=postgresql://USER:PASSWORD@HOST:5432/dagster_v3

# DuckDB runtime settings used by Dagster DuckDBResource assets.
# Large monthly/bulk sources such as Brazil RFB need enough temp spill space.
# Set DUCKDB_TEMP_DIRECTORY to a mounted disk with free space inside the Dagster
# run container, then restart the Dagster code server/daemon so definitions reload.
DUCKDB_TEMP_DIRECTORY=/mnt/big-disk/duckdb-temp
DUCKDB_MAX_TEMP_DIRECTORY_SIZE=150GiB
DUCKDB_THREADS=4
# Optional: cap DuckDB process memory. Leave unset to let DuckDB choose a default.
# DUCKDB_MEMORY_LIMIT=8GiB
# Optional: default is false for lower memory pressure on bulk transforms.
# DUCKDB_PRESERVE_INSERTION_ORDER=false

TEMPORAL_ADDRESS=companycollect:7233
TRANSLATION_PROVIDER_LOCAL_BASE_URL=http://100.77.62.33:8888/v1
TRANSLATION_PROVIDER_LOCAL_MODEL=qwen3:6b
TRANSLATION_PROVIDER_LOCAL_API_KEY=not-needed
TRANSLATION_PROVIDER_MAX_TOKENS=2048
TRANSLATION_PROVIDER_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
# RUN_TRANSLATION_INTEGRATION_TESTS=1
