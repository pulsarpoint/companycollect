# corpscout/.env.example
# Copy to .env and fill in deployment-specific values.

# Scheduler
DATABASE_URL=postgres://corpscout:change-me@companycollect:5432/corpscout?sslmode=disable
CORPSCOUT_TEST_DATABASE_URL=postgres://corpscout:change-me@companycollect:5432/corpscout_test?sslmode=disable

# ClickHouse
CLICKHOUSE_MIGRATE_URL=clickhouse://host.docker.internal:9002?username=default&password=change-me&database=corpscout_sources&x-multi-statement=true
CLICKHOUSE_NATIVE_URL=clickhouse://host.docker.internal:9002?username=default&password=change-me&database=corpscout_sources
FINLAND_PRHYTJ_RUN_DIR=../companies/data/finland/sources/prhytj/runs/20260608T201348Z-prhytj
FINLAND_PRHYTJ_SOURCE_EXPORT_ID=00000000-0000-0000-0000-000000000000

CORPSCOUT_LISTEN_ADDR=:8090
CORPSCOUT_LOG_LEVEL=info
CORPSCOUT_POSTGREST_URL=http://localhost:3000
CORPSCOUT_CRAWL_SERVICE_URL=http://localhost:8096
CORPSCOUT_NATS_URL=nats://companycollect:4222
# Maximum time Corpscout waits for one NATS request/reply before failing the
# Temporal activity. The Temporal activity timeout remains the outer deadline.
CORPSCOUT_NATS_REQUEST_TIMEOUT_SECONDS=180
CORPSCOUT_TEMPORAL_HOST=localhost:7233
CORPSCOUT_TEMPORAL_UI_URL=http://localhost:8089
# Source translation JetStream buffer
CORPSCOUT_TRANSLATION_JETSTREAM_ENABLED=true
CORPSCOUT_TRANSLATION_SOURCE_BUFFER_TARGET=2
CORPSCOUT_TRANSLATION_DISPATCH_INTERVAL_SECONDS=2
CORPSCOUT_TRANSLATION_BATCH_LEASE_SECONDS=1800
TRANSLATION_WORKER_MAX_CONCURRENT_REQUESTS=1
# Official BRREG full units bulk export. Leave as-is unless testing against a fixture server.
CORPSCOUT_BRREG_BULK_SOURCE_URL=https://data.brreg.no/enhetsregisteret/api/enheter/lastned
# Official BRREG Regnskapsregisteret base URL used for source financial statements.
CORPSCOUT_BRREG_FINANCIAL_BASE_URL=https://data.brreg.no
# Official France SIRENE bulk parquet files from data.gouv stable resource URLs.
CORPSCOUT_FRANCE_LEGAL_UNITS_SOURCE_URL=https://www.data.gouv.fr/api/1/datasets/r/350182c9-148a-46e0-8389-76c2ec1374a3
CORPSCOUT_FRANCE_ESTABLISHMENTS_SOURCE_URL=https://www.data.gouv.fr/api/1/datasets/r/a29c1297-1f92-4e2a-8f6b-8c902ce96c5f
# Official NACE Rev. 2.1 source file URL from EU Vocabularies/data.europa.eu.
CORPSCOUT_NACE_REV21_SOURCE_URL=https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2Fbeb2efec-da9a-11ed-a05c-01aa75ed71a1.0001.02%2FDOC_1&fileName=ESTAT-NACE2.1.rdf
# Official ECB daily FX rates feed. Used by the FX sync Temporal workflow.
CORPSCOUT_FX_ECB_DAILY_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# Key used to encrypt LLM provider API keys stored in Postgres.
# Use a stable passphrase, or use base64:<32-byte-key> from: openssl rand -base64 32
# If empty, Corpscout refuses to store API keys and refuses to enable DB-backed LLM providers.
CORPSCOUT_LLM_PROVIDER_KEY_ENCRYPTION_KEY=

# Scheduler object storage for domain imports and crawl artifacts
CORPSCOUT_S3_ENDPOINT=http://localhost:9000
CORPSCOUT_S3_ACCESS_KEY=
CORPSCOUT_S3_SECRET_KEY=
CORPSCOUT_S3_BUCKET=crawls

# Local RustFS credentials. Use the same values as CORPSCOUT_S3_* when running
# the compose stack locally.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Optional source API keys
OPENCORPORATES_API_KEY=

# BRREG translation workflow
# Docker Compose stores temporary SQLite translation worksets in:
#   ./data/scheduler-worksets:/var/lib/corpscout/worksets
# Keep this local folder persistent across scheduler rebuilds while workflows are running.
BRREG_TRANSLATION_PROVIDER=default
BRREG_TRANSLATION_MODEL=qwen3:6b
BRREG_TRANSLATION_PROMPT_VERSION=v1
BRREG_TRANSLATION_SELECTION_LIMIT=1000
BRREG_TRANSLATION_BATCH_SIZE=50
BRREG_TRANSLATION_MAX_PARALLEL_TASKS=50
BRREG_TRANSLATION_LEASE_SECONDS=900
BRREG_TRANSLATION_CONTINUE_AS_NEW_AFTER_BATCHES=500
BRREG_TRANSLATION_MAX_RETRIES=3
BRREG_TRANSLATION_MAX_TASK_ATTEMPTS=3

# BRREG domain discovery workflow
BRREG_DOMAIN_SEARCH_PROVIDER=duckduckgo
BRREG_DOMAIN_PROMPT_VERSION=v1
BRREG_DOMAIN_SELECTION_LIMIT=1000
BRREG_DOMAIN_MAX_ACTIVE_COMPANY_TASKS=2
BRREG_DOMAIN_MAX_PARALLEL_TASKS=2
BRREG_DOMAIN_LEASE_SECONDS=900
BRREG_DOMAIN_CONTINUE_AS_NEW_AFTER_BATCHES=500
BRREG_DOMAIN_MAX_TASK_ATTEMPTS=3

# BRREG financial conversion workflow
BRREG_FINANCIAL_SELECTION_LIMIT=1000
BRREG_FINANCIAL_BATCH_SIZE=500
BRREG_FINANCIAL_MAX_PARALLEL_TASKS=100
BRREG_FINANCIAL_LEASE_SECONDS=900
BRREG_FINANCIAL_CONTINUE_AS_NEW_AFTER_BATCHES=500
BRREG_FINANCIAL_MAX_TASK_ATTEMPTS=3

# UI
BACKEND_URL=http://localhost:8090
